{
  "name": "@nexo/mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Servidor MCP Streamable HTTP para Nexo.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "check": "tsc --noEmit --project tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "inspect": "mcp-inspector --cli --server-url http://127.0.0.1:3100/mcp --transport http --method tools/list"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nexo/api-client": "workspace:*",
    "@nexo/contracts": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.7.0",
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
