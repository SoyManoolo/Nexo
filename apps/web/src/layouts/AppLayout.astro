---
interface Props { title: string; section?: 'projects' | 'inbox' | 'today'; }
const { title, section } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Nexo, tu espacio personal para proyectos y tareas." />
    <title>{title}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="brand" href="/projects" aria-label="Nexo, inicio">nexo<span>.</span></a>
        <nav aria-label="Navegación principal">
          <a href="/inbox" aria-current={section === 'inbox' ? 'page' : undefined}>Inbox</a>
          <a href="/today" aria-current={section === 'today' ? 'page' : undefined}>Hoy</a>
          <a href="/projects" aria-current={section === 'projects' ? 'page' : undefined}>Proyectos</a>
        </nav>
        <p class="sidebar-note">Haz sitio para lo importante.</p>
      </aside>
      <div class="content"><slot /></div>
    </div>
  </body>
</html>

<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #17211c; background: #f7f7f2; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  button, input, select, textarea { font: inherit; }
  button { cursor: pointer; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid #75b88c; outline-offset: 3px; }
  .app-shell { min-height: 100vh; display: grid; grid-template-columns: 13.5rem minmax(0, 1fr); }
  .sidebar { display: flex; flex-direction: column; gap: 2.5rem; padding: 2rem 1.3rem; background: #ecf1e9; border-right: 1px solid #dce2da; }
  .brand { width: fit-content; text-decoration: none; font-size: 2rem; font-weight: 800; letter-spacing: -0.08em; }
  .brand span { color: #3d7655; }
  .sidebar nav { display: grid; gap: 0.3rem; }
  .sidebar nav a { padding: 0.75rem 0.9rem; border-radius: 0.7rem; text-decoration: none; color: #415047; font-weight: 600; }
  .sidebar nav a:hover, .sidebar nav a[aria-current="page"] { background: #dbe9da; color: #173a27; }
  .sidebar-note { margin: auto 0 0; color: #69776d; font-size: 0.8rem; line-height: 1.5; }
  .content { min-width: 0; }
  .page { width: min(100% - 2rem, 64rem); margin: 0 auto; padding: 3.5rem 0 6rem; }
  .eyebrow { margin: 0 0 0.7rem; color: #3d7655; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; }
  .page h1 { margin: 0; font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.06; letter-spacing: -0.05em; }
  .page-intro { margin: 0.8rem 0 0; color: #58665c; line-height: 1.5; }
  .page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  .card { background: #fff; border: 1px solid #dce2da; border-radius: 1rem; padding: 1.4rem; }
  .card h2 { margin: 0 0 0.9rem; font-size: 1.1rem; }
  .muted { color: #58665c; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; border: 1px solid #316d4b; border-radius: 0.65rem; padding: 0.7rem 1rem; background: #316d4b; color: #fff; text-decoration: none; font-weight: 700; }
  .button:hover { background: #245b3b; }
  .button.secondary { background: #fff; color: #27583b; }
  .button.secondary:hover { background: #edf5ee; }
  .button.danger { background: #fff; border-color: #b35b50; color: #9b382c; }
  .field { display: grid; gap: 0.4rem; font-size: 0.9rem; font-weight: 650; }
  .field input, .field textarea, .field select { width: 100%; border: 1px solid #bac8bc; border-radius: 0.6rem; padding: 0.7rem 0.8rem; background: #fff; color: #17211c; font-weight: 400; }
  .field textarea { min-height: 6rem; resize: vertical; }
  .form-grid { display: grid; gap: 1rem; }
  .notice { padding: 1.4rem; border: 1px solid #dce2da; border-radius: 0.8rem; background: #fff; }
  .notice.error { border-color: #d99890; background: #fff5f2; color: #7f2f26; }
  .notice h2 { margin: 0 0 0.5rem; font-size: 1.1rem; }
  .notice p { margin: 0; line-height: 1.5; }
  @media (max-width: 720px) {
    .app-shell { display: block; }
    .sidebar { padding: 0.8rem 1rem; gap: 0.4rem; border-right: 0; border-bottom: 1px solid #dce2da; }
    .sidebar nav { display: flex; overflow-x: auto; }
    .sidebar nav a { white-space: nowrap; }
    .sidebar-note { display: none; }
    .page { padding-top: 2rem; }
    .page-header { align-items: flex-start; flex-direction: column; }
  }
</style>
