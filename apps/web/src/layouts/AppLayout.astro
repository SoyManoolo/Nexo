---
interface Props { title: string; section?: 'home' | 'projects' | 'inbox' | 'today' | 'settings' | 'search' | 'weekly'; }
const { title, section } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Nexo, tu espacio personal para proyectos y tareas." />
    <title>{title}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('nexo-theme');
        const theme = savedTheme === 'dark' || savedTheme === 'light'
          ? savedTheme
          : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      } catch { /* Storage unavailable. */ }
    </script>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-top">
          <a class="brand" href="/" aria-label="Nexo, inicio"><span class="brand-full">nexo</span><span class="brand-short" hidden>N</span><span class="brand-dot">.</span></a>
          <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="Contraer menú" aria-expanded="true" aria-controls="sidebar-nav">☰</button>
        </div>
        <nav id="sidebar-nav" aria-label="Navegación principal">
          <a href="/" aria-label="Inicio" aria-current={section === 'home' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">⌂</span><span class="nav-label">Inicio</span></a>
          <a href="/inbox" aria-label="Inbox" aria-current={section === 'inbox' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">☷</span><span class="nav-label">Inbox</span></a>
          <a href="/today" aria-label="Hoy" aria-current={section === 'today' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">◷</span><span class="nav-label">Hoy</span></a>
          <a href="/projects" aria-label="Proyectos" aria-current={section === 'projects' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">▦</span><span class="nav-label">Proyectos</span></a>
          <a href="/search" aria-label="Buscar" aria-current={section === 'search' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">⌕</span><span class="nav-label">Buscar</span></a>
          <a href="/weekly" aria-label="Resumen semanal" aria-current={section === 'weekly' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">◷</span><span class="nav-label">Esta semana</span></a>
          <a href="/settings" aria-label="Ajustes" aria-current={section === 'settings' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">⚙</span><span class="nav-label">Ajustes</span></a>
        </nav>
        <p class="sidebar-note">Haz sitio para lo importante.</p>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Activar modo oscuro" aria-pressed="false">
          <span aria-hidden="true">☾</span><span class="theme-label">Modo oscuro</span>
        </button>
      </aside>
      <div class="content"><slot /></div>
    </div>
    <dialog class="task-modal task-detail-modal" id="task-detail-modal" aria-label="Detalles de la tarea">
      <button class="modal-close task-detail-close" type="button" aria-label="Cerrar tarea">×</button>
      <div class="task-detail-content"></div>
    </dialog>
    <script is:inline>
      const shell = document.querySelector('.app-shell');
      const toggle = document.querySelector('#sidebar-toggle');
      const fullBrand = document.querySelector('.brand-full');
      const shortBrand = document.querySelector('.brand-short');
      const themeToggle = document.querySelector('#theme-toggle');
      function setCollapsed(collapsed) {
        shell?.classList.toggle('is-collapsed', collapsed);
        if (fullBrand) fullBrand.hidden = collapsed;
        if (shortBrand) shortBrand.hidden = !collapsed;
        toggle?.setAttribute('aria-expanded', String(!collapsed));
        toggle?.setAttribute('aria-label', collapsed ? 'Desplegar menú' : 'Contraer menú');
      }
      try { setCollapsed(localStorage.getItem('nexo-sidebar-collapsed') === 'true'); } catch { /* Storage unavailable. */ }
      toggle?.addEventListener('click', () => {
        const collapsed = !shell?.classList.contains('is-collapsed');
        setCollapsed(collapsed);
        try { localStorage.setItem('nexo-sidebar-collapsed', String(collapsed)); } catch { /* Storage unavailable. */ }
      });
      function setTheme(theme) {
        document.documentElement.dataset.theme = theme;
        const isDark = theme === 'dark';
        themeToggle?.setAttribute('aria-pressed', String(isDark));
        themeToggle?.setAttribute('aria-label', isDark ? 'Activar modo claro' : 'Activar modo oscuro');
        const label = themeToggle?.querySelector('.theme-label');
        if (label) label.textContent = isDark ? 'Modo claro' : 'Modo oscuro';
      }
      setTheme(document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
      themeToggle?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        setTheme(theme);
        try { localStorage.setItem('nexo-theme', theme); } catch { /* Storage unavailable. */ }
      });

      const taskModal = document.querySelector('#task-detail-modal');
      const taskModalContent = taskModal?.querySelector('.task-detail-content');
      let taskModalScrollY = 0;
      let taskModalBodyStyles = null;
      function closeTaskModal() { taskModal?.close(); }
      function setTaskModalScrollLock(locked) {
        const body = document.body;
        if (locked) {
          if (taskModalBodyStyles) return;
          taskModalScrollY = window.scrollY;
          taskModalBodyStyles = {
            position: body.style.position,
            top: body.style.top,
            left: body.style.left,
            right: body.style.right,
            width: body.style.width,
          };
          body.classList.add('task-modal-open');
          body.style.position = 'fixed';
          body.style.top = `-${taskModalScrollY}px`;
          body.style.left = '0';
          body.style.right = '0';
          body.style.width = '100%';
          return;
        }
        if (!taskModalBodyStyles) return;
        body.classList.remove('task-modal-open');
        Object.assign(body.style, taskModalBodyStyles);
        taskModalBodyStyles = null;
        window.scrollTo(0, taskModalScrollY);
      }
      function renderTaskModal(html, taskUrl) {
        if (!taskModalContent || !taskModal) return;
        const parsed = new DOMParser().parseFromString(html, 'text/html');
        const page = parsed.querySelector('main.page');
        if (!page) return;
        page.querySelector('.back-link')?.remove();
        page.querySelectorAll('form').forEach((form) => {
          if (!form.getAttribute('action')) form.setAttribute('action', taskUrl);
        });
        taskModalContent.replaceChildren(page);
        initializeTaskForm(taskModalContent);
        if (!taskModal.open) {
          taskModal.showModal();
          setTaskModalScrollLock(true);
        }
      }
      function initializeTaskForm(root) {
        const form = root.querySelector('#task-form');
        const status = root.querySelector('#task-status');
        const blockedField = root.querySelector('#blocked-reason-field');
        const blockedInput = blockedField?.querySelector('input');
        const syncBlockedReason = () => {
          const isBlocked = status?.value === 'blocked';
          if (blockedField) blockedField.hidden = !isBlocked;
          if (blockedInput) blockedInput.required = isBlocked;
        };
        status?.addEventListener('change', syncBlockedReason);
        syncBlockedReason();
        for (const [inputId] of [['task-due-at'], ['task-started-at']]) {
          const input = root.querySelector('#' + inputId);
          if (input?.dataset.iso) {
            const date = new Date(input.dataset.iso);
            input.value = new Date(date.getTime() - date.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
          }
        }
        form?.addEventListener('submit', (event) => {
          event.preventDefault();
          const dueAt = form.elements.namedItem('dueAt');
          const dueAtIso = form.elements.namedItem('dueAtIso');
          const startedAt = form.elements.namedItem('startedAt');
          const startedAtIso = form.elements.namedItem('startedAtIso');
          if (dueAtIso && dueAt) dueAtIso.value = dueAt.value ? new Date(dueAt.value).toISOString() : '';
          if (startedAtIso && startedAt) startedAtIso.value = startedAt.value ? new Date(startedAt.value).toISOString() : '';
          submitTaskModalForm(form, event.submitter);
        });
      }
      async function submitTaskModalForm(form, submitter) {
        const taskUrl = form.getAttribute('action') || location.href;
        const response = await fetch(taskUrl, { method: 'POST', body: submitter ? new FormData(form, submitter) : new FormData(form), headers: { 'Accept': 'text/html' } });
        renderTaskModal(await response.text(), taskUrl);
      }
      document.addEventListener('click', async (event) => {
        const link = event.target.closest('a[href]');
        if (!link || event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target || link.hasAttribute('download')) return;
        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin || !/^\/tasks\/[^/]+\/?$/.test(url.pathname)) return;
        event.preventDefault();
        try {
          const response = await fetch(url.href, { headers: { 'Accept': 'text/html' } });
          renderTaskModal(await response.text(), url.href);
        } catch (error) {
          console.error('No se pudo abrir la tarea:', error);
          location.assign(url.href);
        }
      });
      taskModal?.addEventListener('click', (event) => { if (event.target === taskModal) closeTaskModal(); });
      taskModal?.addEventListener('close', () => setTaskModalScrollLock(false));
      taskModal?.querySelector('.task-detail-close')?.addEventListener('click', closeTaskModal);
      taskModal?.addEventListener('click', (event) => {
        if (event.target.closest('.back-link')) { event.preventDefault(); closeTaskModal(); }
      });
      taskModal?.addEventListener('submit', (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || form.id === 'task-form') return;
        event.preventDefault();
        submitTaskModalForm(form, event.submitter);
      });
    </script>
  </body>
</html>

<style is:inline>
  :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color-scheme: light; --page-bg: #f7f7f2; --text: #17211c; --surface: #fff; --surface-muted: #f7faf7; --sidebar: #ecf1e9; --border: #dce2da; --subtle: #58665c; --accent-soft: #dbe9da; --accent-text: #27583b; color: var(--text); background: var(--page-bg); }
  :root[data-theme="dark"] { color-scheme: dark; --page-bg: #151b17; --text: #e7eee8; --surface: #202922; --surface-muted: #263129; --sidebar: #1a241d; --border: #3b4b40; --subtle: #b2c0b5; --accent-soft: #2d4937; --accent-text: #9ed5af; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  button, input, select, textarea { font: inherit; }
  button { cursor: pointer; }
  a { color: inherit; }
  [hidden] { display: none !important; }
  :focus-visible { outline: 3px solid #75b88c; outline-offset: 3px; }
  .app-shell { min-height: 100vh; display: grid; grid-template-columns: 13.5rem minmax(0, 1fr); }
  .app-shell.is-collapsed { grid-template-columns: 4.5rem minmax(0, 1fr); }
  .sidebar { display: flex; flex-direction: column; gap: 2.5rem; padding: 2rem 1.3rem; background: var(--sidebar); border-right: 1px solid var(--border); }
  .is-collapsed .sidebar { padding-inline: 0.55rem; }
  .sidebar-top { display: flex; align-items: center; justify-content: space-between; gap: 0.3rem; }
  .brand { width: fit-content; text-decoration: none; font-size: 2rem; font-weight: 800; letter-spacing: -0.08em; }
  .brand-dot { color: #3d7655; }
  .brand-short { display: none; }
  .is-collapsed .brand-full, .is-collapsed .sidebar-note, .is-collapsed .nav-label { display: none; }
  .is-collapsed .brand-short { display: inline; }
  .sidebar-toggle { border: 0; background: transparent; color: var(--accent-text); font-size: 1.2rem; padding: 0.25rem; border-radius: 0.35rem; }
  .sidebar-toggle:hover { background: var(--accent-soft); }
  .sidebar nav { display: grid; gap: 0.3rem; }
  .sidebar nav a { display: flex; align-items: center; gap: 0.6rem; padding: 0.75rem 0.9rem; border-radius: 0.7rem; text-decoration: none; color: var(--subtle); font-weight: 600; }
  .is-collapsed .sidebar nav a { justify-content: center; padding-inline: 0.3rem; }
  .nav-icon { width: 1rem; text-align: center; font-size: 1.2rem; line-height: 1; }
  .sidebar nav a:hover, .sidebar nav a[aria-current="page"] { background: var(--accent-soft); color: var(--text); }
  .sidebar-note { margin: auto 0 0; color: var(--subtle); font-size: 0.8rem; line-height: 1.5; }
  .theme-toggle { display: flex; align-items: center; gap: 0.55rem; border: 1px solid var(--border); border-radius: 0.65rem; padding: 0.6rem 0.75rem; background: transparent; color: var(--accent-text); font-size: 0.85rem; font-weight: 700; text-align: left; }
  .theme-toggle:hover { background: var(--accent-soft); }
  .is-collapsed .theme-toggle { justify-content: center; padding-inline: 0.35rem; }
  .is-collapsed .theme-label { display: none; }
  .content { min-width: 0; }
  .page { width: min(100% - 6rem, 96rem); margin: 0 auto; padding: 3.5rem 0 6rem; }
  .eyebrow { margin: 0 0 0.7rem; color: #3d7655; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.13em; text-transform: uppercase; }
  .page h1 { margin: 0; font-size: clamp(2.2rem, 5vw, 3.6rem); line-height: 1.06; letter-spacing: -0.05em; }
  .page-intro { margin: 0.8rem 0 0; color: var(--subtle); line-height: 1.5; }
  .page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 1rem; padding: 1.4rem; }
  .card h2 { margin: 0 0 0.9rem; font-size: 1.1rem; }
  .muted { color: var(--subtle); }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; border: 1px solid #316d4b; border-radius: 0.65rem; padding: 0.7rem 1rem; background: #316d4b; color: #fff; text-decoration: none; font-weight: 700; }
  .button:hover { background: #245b3b; }
  .button.secondary { background: var(--surface); color: var(--accent-text); }
  .button.secondary:hover { background: var(--accent-soft); }
  .button.danger { background: var(--surface); border-color: #b35b50; color: #e88d83; }
  .field { display: grid; gap: 0.4rem; font-size: 0.9rem; font-weight: 650; }
  .field input, .field textarea, .field select { width: 100%; border: 1px solid var(--border); border-radius: 0.6rem; padding: 0.7rem 0.8rem; background: var(--surface); color: var(--text); font-weight: 400; }
  .field textarea { min-height: 6rem; resize: vertical; }
  .form-grid { display: grid; gap: 1rem; }
  .notice { padding: 1.4rem; border: 1px solid var(--border); border-radius: 0.8rem; background: var(--surface); }
  .notice.error { border-color: #d99890; background: #fff5f2; color: #7f2f26; }
  .notice h2 { margin: 0 0 0.5rem; font-size: 1.1rem; }
  .notice p { margin: 0; line-height: 1.5; }
  :root[data-theme="dark"] .task-column, :root[data-theme="dark"] .weekday { background: var(--surface-muted); }
  :root[data-theme="dark"] .calendar-day.outside-month { background: #1b241e; }
  :root[data-theme="dark"] .view-switch, :root[data-theme="dark"] .view-switch a[aria-current="page"], :root[data-theme="dark"] .task-action { background: var(--surface); color: var(--text); }
  :root[data-theme="dark"] .calendar-event { background: #294637; color: #e7eee8; }
  :root[data-theme="dark"] .calendar-event.deadline { background: #4d3729; }
  :root[data-theme="dark"] .calendar-event.both { background: #3b3049; }
  :root[data-theme="dark"] .period,
  :root[data-theme="dark"] .legend,
  :root[data-theme="dark"] .empty,
  :root[data-theme="dark"] .task small,
  :root[data-theme="dark"] .task-link small,
  :root[data-theme="dark"] .project small,
  :root[data-theme="dark"] .pending-count,
  :root[data-theme="dark"] .empty-column,
  :root[data-theme="dark"] .weekday,
  :root[data-theme="dark"] .calendar-day time,
  :root[data-theme="dark"] .task-column h2,
  :root[data-theme="dark"] .task-column h3,
  :root[data-theme="dark"] .task-column p,
  :root[data-theme="dark"] .tabs a,
  :root[data-theme="dark"] .task-group h2,
  :root[data-theme="dark"] .archive-panel p { color: var(--subtle); }
  :root[data-theme="dark"] .view-switch,
  :root[data-theme="dark"] .view-switch a[aria-current="page"],
  :root[data-theme="dark"] .task-column,
  :root[data-theme="dark"] .task-modal,
  :root[data-theme="dark"] .project-modal { background: var(--surface); color: var(--text); }
  :root[data-theme="dark"] .calendar-grid,
  :root[data-theme="dark"] .weekday,
  :root[data-theme="dark"] .calendar-day,
  :root[data-theme="dark"] .calendar-day.outside-month,
  :root[data-theme="dark"] .period-nav,
  :root[data-theme="dark"] .view-switcher,
  :root[data-theme="dark"] .view-switcher a + a,
  :root[data-theme="dark"] .task-column,
  :root[data-theme="dark"] .archive-panel { border-color: var(--border); }
  :root[data-theme="dark"] .task-column { background: var(--surface-muted); }
  :root[data-theme="dark"] .period-nav { background: var(--surface); color: var(--text); }
  :root[data-theme="dark"] .view-switcher a { color: var(--accent-text); }
  :root[data-theme="dark"] .view-switcher a[aria-current="page"] { color: #fff; }
  :root[data-theme="dark"] .notice.error { border-color: #75443f; background: #332321; color: #ffc4bb; }
  :root[data-theme="dark"] .calendar-event.deadline { color: #ffe0c9; }
  :root[data-theme="dark"] .calendar-event.both { color: #eadbff; }
  :root[data-theme="dark"] .task-action { border-color: var(--border); color: var(--accent-text); }
  .task-detail-modal { width: min(58rem, calc(100% - 2rem)); height: auto; max-width: none; max-height: calc(100dvh - 1rem); overflow-y: auto; overscroll-behavior: contain; border: 1px solid var(--border); border-radius: 1rem; padding: 0; background: var(--surface); color: var(--text); box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.35); }
  .task-detail-modal::backdrop { background: rgb(10 18 13 / 0.62); }
  .task-detail-content > .page { width: auto; margin: 0; padding: 1.5rem; }
  .task-detail-content .page-header { margin-bottom: 1rem; padding-right: 2.5rem; }
  .task-detail-content .page h1 { font-size: clamp(1.65rem, 3vw, 2.25rem); line-height: 1.12; letter-spacing: -0.035em; }
  .task-detail-content .task-layout { display: grid; grid-template-columns: minmax(0, 1fr) 13rem; gap: 1rem; align-items: start; }
  .task-detail-content .field-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; }
  .task-detail-content .task-layout > .card { padding: 1rem; }
  .task-detail-content .task-layout h2 { margin-bottom: 0.7rem; }
  .task-detail-content .field textarea { min-height: 4rem; }
  .task-detail-content #task-notes { min-height: 8rem; }
  .task-detail-content .actions { display: grid; gap: 0.7rem; }
  .task-detail-content .actions form, .task-detail-content .actions button { width: 100%; }
  .task-detail-close { position: absolute; z-index: 2; top: 0.8rem; right: 0.8rem; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; margin: 0; padding: 0 0 0.12rem; border: 1px solid var(--border); border-radius: 50%; background: var(--surface-muted); color: var(--subtle); font-size: 1.45rem; line-height: 1; transition: background 120ms ease, color 120ms ease, border-color 120ms ease; }
  .task-detail-close:hover { border-color: var(--accent-text); background: var(--accent-soft); color: var(--text); }
  .task-detail-close:focus-visible { outline: 3px solid #75b88c; outline-offset: 2px; }
  body.task-modal-open { overflow: hidden; }
  @media (max-width: 900px) { .task-detail-content .task-layout { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .task-detail-content .field-pair { grid-template-columns: 1fr; } }
  @media (max-width: 720px) {
    .app-shell, .app-shell.is-collapsed { display: block; }
    .sidebar { padding: 0.8rem 1rem; gap: 0.4rem; border-right: 0; border-bottom: 1px solid #dce2da; }
    .is-collapsed .sidebar { padding: 0.8rem 1rem; }
    .sidebar nav { display: flex; overflow-x: auto; }
    .sidebar nav a { white-space: nowrap; }
    .is-collapsed .sidebar nav { display: none; }
    .sidebar-note { display: none; }
    .theme-toggle { position: absolute; right: 1rem; top: 0.8rem; }
    .page { width: min(100% - 3rem, 96rem); padding-top: 2rem; }
    .page-header { align-items: flex-start; flex-direction: column; }
  }
</style>
