---
import AppLayout from '../layouts/AppLayout.astro';
import { createApiClient } from '../lib/api';
import { formError } from '../lib/form-error';
import { isSameOrigin } from '../lib/security';
import type { Project, WeeklyReportAutomation } from '@nexo/contracts';

const days = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];
let automation: WeeklyReportAutomation | null = null;
let projects: Project[] = [];
let errorMessage: string | null = null;
let successMessage: string | null = null;

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request, Astro.url)) return new Response('Origen no permitido', { status: 403 });
  const form = await Astro.request.formData();
  try {
    const api = createApiClient();
    if (form.get('intent') === 'update-settings') {
      await api.updateWeeklyReportSettings({
        enabled: form.get('enabled') === 'on',
        recipient: String(form.get('recipient') ?? ''),
        scheduleDay: Number(form.get('scheduleDay')),
        scheduleHour: Number(form.get('scheduleHour')),
        timeZone: String(form.get('timeZone') ?? ''),
      });
      successMessage = 'La configuración del informe semanal se ha guardado.';
    } else if (form.get('intent') === 'update-project') {
      const id = String(form.get('id') ?? '');
      await api.updateWeeklyReportProject(id, {
        projectId: String(form.get('projectId') ?? '') || null,
        name: String(form.get('name') ?? ''),
        repository: String(form.get('repository') ?? ''),
        focus: String(form.get('focus') ?? ''),
        enabled: form.get('enabled') === 'on',
        sortOrder: Number(form.get('sortOrder')),
      });
      successMessage = 'El proyecto del informe se ha actualizado.';
    }
  } catch (error) {
    console.error('No se pudo actualizar la automatización:', error);
    const failure = formError(error, 'No se pudo guardar la automatización.');
    errorMessage = failure.message;
    Astro.response.status = failure.status;
  }
}

try {
  const api = createApiClient();
  [automation, projects] = await Promise.all([api.getWeeklyReportAutomation(), api.listProjects({ status: 'active' })]);
} catch (error) {
  console.error('No se pudo cargar la automatización:', error);
  errorMessage ??= 'No se pudo cargar la configuración. Comprueba la conexión con la API.';
}

const fmt = (date: string | null) => date
  ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Madrid' }).format(new Date(date))
  : '—';
const statusLabel = (value: string) => ({ pending: 'Pendiente', sent: 'Enviado', failed: 'Falló', generated: 'Generado', running: 'En curso', succeeded: 'Correcta' }[value] ?? value);
---

<AppLayout title="Automatizaciones · Nexo" section="automations">
  <main class="page">
    <header class="page-header"><div><p class="eyebrow">Control local</p><h1>Automatizaciones</h1><p class="page-intro">Configura los informes sin exponer las credenciales de correo ni ejecutar comandos desde el navegador.</p></div></header>
    {errorMessage && <div class="notice error" role="alert"><p>{errorMessage}</p></div>}
    {successMessage && <div class="notice success" role="status"><p>{successMessage}</p></div>}
    {!automation ? <section class="notice"><p>No hay información disponible todavía.</p></section> : <>
      <section class="card" aria-labelledby="weekly-heading">
        <div class="section-heading"><div><p class="eyebrow">Informe semanal</p><h2 id="weekly-heading">Programación y destinatario</h2></div><span class:list={['status', automation.settings.enabled ? 'active' : '']}>{automation.settings.enabled ? 'Activa' : 'Pausada'}</span></div>
        <p class="muted">El temporizador de systemd ejecuta Codex en la GEEKOM. Cambiar estos valores modifica lo que el agente local usará en la siguiente ejecución; no revela la contraseña de Gmail.</p>
        <form method="post" class="settings-grid">
          <input type="hidden" name="intent" value="update-settings" />
          <label class="field checkbox"><input name="enabled" type="checkbox" checked={automation.settings.enabled} /> Activar informes semanales</label>
          <label class="field">Destinatario <input name="recipient" type="email" required maxlength="320" value={automation.settings.recipient} /></label>
          <label class="field">Día <select name="scheduleDay">{days.map((day, index) => <option value={index + 1} selected={automation.settings.scheduleDay === index + 1}>{day}</option>)}</select></label>
          <label class="field">Hora local <select name="scheduleHour">{Array.from({ length: 24 }, (_, hour) => <option value={hour} selected={automation.settings.scheduleHour === hour}>{String(hour).padStart(2, '0')}:00</option>)}</select></label>
          <label class="field">Zona horaria <input name="timeZone" required maxlength="80" value={automation.settings.timeZone} /></label>
          <button class="button" type="submit">Guardar programación</button>
        </form>
        <p class="help">El correo se considera configurado cuando la ejecución local consigue autenticar con Gmail. La contraseña de aplicación permanece únicamente en la GEEKOM.</p>
      </section>

      <section class="section-block" aria-labelledby="projects-heading"><div><p class="eyebrow">Alcance</p><h2 id="projects-heading">Proyectos incluidos</h2><p class="muted">Edita el repositorio, el foco del análisis y si cada proyecto participa en el informe.</p></div><div class="project-grid">{automation.projects.map((reportProject) => <form method="post" class="card project-form">
        <input type="hidden" name="intent" value="update-project" /><input type="hidden" name="id" value={reportProject.id} />
        <label class="field checkbox"><input name="enabled" type="checkbox" checked={reportProject.enabled} /> Incluir en informes</label>
        <label class="field">Nombre <input name="name" required maxlength="120" value={reportProject.name} /></label>
        <label class="field">Repositorio <input name="repository" required pattern="[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+" value={reportProject.repository} /></label>
        <label class="field">Proyecto de Nexo <select name="projectId"><option value="">Sin vincular</option>{projects.map((project) => <option value={project.id} selected={reportProject.projectId === project.id}>{project.name}</option>)}</select></label>
        <label class="field">Foco técnico <textarea name="focus" maxlength="10000">{reportProject.focus}</textarea></label>
        <label class="field">Orden <input name="sortOrder" type="number" min="0" max="10000" value={reportProject.sortOrder} /></label>
        <button class="button secondary" type="submit">Guardar proyecto</button>
      </form>)}</div></section>

      <section class="section-block" aria-labelledby="history-heading"><div><p class="eyebrow">Historial</p><h2 id="history-heading">Últimos informes</h2></div>{automation.reports.length ? <div class="card table-wrap"><table><thead><tr><th>Proyecto</th><th>Fecha</th><th>Informe</th><th>Correo</th><th>Enviado</th></tr></thead><tbody>{automation.reports.map((report) => <tr><td>{report.projectName}</td><td>{report.reportDate}</td><td><span class:list={['status', report.status === 'generated' ? 'active' : 'failed']}>{statusLabel(report.status)}</span></td><td><span class:list={['status', report.emailStatus === 'sent' ? 'active' : report.emailStatus === 'failed' ? 'failed' : '']}>{statusLabel(report.emailStatus)}</span></td><td>{fmt(report.sentAt)}</td></tr>)}</tbody></table></div> : <p class="muted">Todavía no hay informes sincronizados. Aparecerán tras la siguiente ejecución o una importación local.</p>}</section>

      <section class="section-block" aria-labelledby="runs-heading"><div><p class="eyebrow">Ejecuciones</p><h2 id="runs-heading">Estado reciente</h2></div>{automation.runs.length ? <div class="card table-wrap"><table><thead><tr><th>Inicio</th><th>Resultado</th><th>Resumen</th></tr></thead><tbody>{automation.runs.map((run) => <tr><td>{fmt(run.startedAt)}</td><td><span class:list={['status', run.status === 'succeeded' ? 'active' : run.status === 'failed' ? 'failed' : '']}>{statusLabel(run.status)}</span></td><td>{run.error ?? run.summary ?? '—'}</td></tr>)}</tbody></table></div> : <p class="muted">Aún no hay ejecuciones sincronizadas.</p>}</section>
    </>}
  </main>
</AppLayout>

<style>
  .section-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; } .section-heading h2 { margin: 0; } .section-heading .eyebrow { margin-bottom: 0.35rem; }
  .status { display: inline-flex; width: fit-content; border-radius: 2rem; padding: 0.3rem 0.65rem; background: var(--surface-muted); color: var(--subtle); font-size: 0.82rem; font-weight: 750; white-space: nowrap; }.status.active { background: var(--accent-soft); color: var(--accent-text); }.status.failed { background: #fff0ed; color: #9b3a2d; }
  .settings-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }.checkbox { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.55rem; }.checkbox input { width: auto; }.settings-grid .button { width: fit-content; align-self: end; }.help { margin: 1.2rem 0 0; color: var(--subtle); font-size: 0.9rem; line-height: 1.5; }
  .section-block { margin-top: 2.5rem; }.section-block > div:first-child h2 { margin: 0.2rem 0 0.4rem; }.section-block > div:first-child p { margin-bottom: 1rem; }.project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }.project-form { display: grid; gap: 0.85rem; }.project-form .checkbox { grid-column: auto; }
  .table-wrap { overflow-x: auto; padding: 0; } table { width: 100%; border-collapse: collapse; min-width: 42rem; } th, td { padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); text-align: left; vertical-align: top; } th { color: var(--subtle); font-size: 0.82rem; } tbody tr:last-child td { border-bottom: 0; }.notice.success { margin-bottom: 1rem; border-color: #8eb99a; background: #eff8f0; color: #245b3b; }
  :root[data-theme="dark"] .notice.success { background: #203828; color: #bde7c7; }:root[data-theme="dark"] .status.failed { background: #452923; color: #ffc1b8; }
  @media (max-width: 760px) { .settings-grid, .project-grid { grid-template-columns: 1fr; } }
</style>
