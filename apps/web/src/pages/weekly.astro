---
import AppLayout from '../layouts/AppLayout.astro';
import { createApiClient } from '../lib/api';
import type { Project, Task } from '@nexo/contracts';

const timeZone = process.env.NEXO_TIME_ZONE ?? 'Europe/Madrid';
const localDay = new Intl.DateTimeFormat('sv-SE', { timeZone });
const today = localDay.format(new Date());
const requestedWeek = Astro.url.searchParams.get('week');
const selectedDay = requestedWeek && /^\d{4}-\d{2}-\d{2}$/.test(requestedWeek) &&
  !Number.isNaN(Date.parse(`${requestedWeek}T12:00:00Z`)) &&
  new Date(`${requestedWeek}T12:00:00Z`).toISOString().slice(0, 10) === requestedWeek
  ? requestedWeek : today;
const parseDay = (value: string) => new Date(`${value}T12:00:00Z`);
const dayKey = (value: Date) => value.toISOString().slice(0, 10);
const addDays = (value: Date, amount: number) => { const date = new Date(value); date.setUTCDate(date.getUTCDate() + amount); return date; };
const todayDate = parseDay(today);
const weekStart = addDays(todayDate, -((todayDate.getUTCDay() + 6) % 7));
const selectedDate = parseDay(selectedDay);
const selectedWeekStart = addDays(selectedDate, -((selectedDate.getUTCDay() + 6) % 7));
const selectedWeekEnd = addDays(selectedWeekStart, 7);
const nextWeekStart = addDays(weekStart, 7);
const previousWeekStart = addDays(weekStart, -7);
const startKey = dayKey(weekStart);
const endKey = dayKey(addDays(nextWeekStart, -1));
const inRange = (value: string | null, start: string, end: string) => Boolean(value && value >= start && value < end);
const completedDay = (task: Task) => task.completedAt ? localDay.format(new Date(task.completedAt)) : null;
const weekLabel = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', timeZone: 'UTC' });
let tasks: Task[] = [];
let projects: Project[] = [];
let errorMessage: string | null = null;
try {
  const api = createApiClient();
  [tasks, projects] = await Promise.all([api.listTasks(), api.listProjects({ status: 'active' })]);
} catch (error) {
  console.error('No se pudo cargar el resumen semanal:', error);
  errorMessage = 'No se pudo cargar el resumen semanal. Comprueba la conexión con la API.';
}
const projectNames = new Map(projects.map((project) => [project.id, project.name]));
const completedThisWeek = tasks.filter((task) => inRange(completedDay(task), startKey, dayKey(nextWeekStart))).length;
const completedLastWeek = tasks.filter((task) => inRange(completedDay(task), dayKey(previousWeekStart), startKey)).length;
const createdThisWeek = tasks.filter((task) => inRange(localDay.format(new Date(task.createdAt)), startKey, dayKey(nextWeekStart))).length;
const open = tasks.filter((task) => task.status !== 'done');
const blocked = open.filter((task) => task.status === 'blocked');
const overdue = open.filter((task) => task.dueAt && localDay.format(new Date(task.dueAt)) < today);
const dueThisWeek = open.filter((task) => {
  const dueDay = task.dueAt ? localDay.format(new Date(task.dueAt)) : task.scheduledFor;
  return dueDay && dueDay >= today && dueDay <= endKey;
});
const days = Array.from({ length: 7 }, (_, index) => {
  const date = addDays(selectedWeekStart, index);
  const key = dayKey(date);
  const count = tasks.filter((task) => completedDay(task) === key).length;
  const label = new Intl.DateTimeFormat('es-ES', { weekday: 'short', timeZone: 'UTC' }).format(date);
  return { key, label, count };
});
const maxDaily = Math.max(1, ...days.map((day) => day.count));
const weeklyHistory = Array.from({ length: 8 }, (_, index) => {
  const start = addDays(weekStart, (index - 7) * 7);
  const end = addDays(start, 7);
  const count = tasks.filter((task) => inRange(completedDay(task), dayKey(start), dayKey(end))).length;
  return { label: weekLabel.format(start), count };
});
const historyMax = Math.max(1, ...weeklyHistory.map((week) => week.count));
const linePoints = weeklyHistory.map((week, index) =>
  `${36 + index * 72},${124 - week.count / historyMax * 100}`).join(' ');
const dateRange = `${weekLabel.format(weekStart)} – ${weekLabel.format(addDays(nextWeekStart, -1))}`;
const selectedRange = `${weekLabel.format(selectedWeekStart)} – ${weekLabel.format(addDays(selectedWeekEnd, -1))}`;
const fmtDate = (iso: string) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', timeZone }).format(new Date(iso));
---

<AppLayout title="Esta semana · Nexo" section="weekly">
  <main class="page">
    <header class="page-header"><div><p class="eyebrow">Revisión semanal</p><h1>Esta semana</h1><p class="page-intro">{dateRange} · Un vistazo a lo que avanzó y a lo que requiere atención.</p></div></header>
    {errorMessage ? <div class="notice error" role="alert"><p>{errorMessage}</p><a href="/weekly">Volver a intentar</a></div> : <>
      <section class="metrics" aria-label="Resumen de la semana">
        <a class="metric card" href="/?status=done"><span>Completadas</span><strong>{completedThisWeek}</strong><small>{completedThisWeek > completedLastWeek ? `+${completedThisWeek - completedLastWeek} respecto a la semana pasada` : completedThisWeek < completedLastWeek ? `${completedThisWeek - completedLastWeek} respecto a la semana pasada` : 'Igual que la semana pasada'}</small></a>
        <a class="metric card" href="/"><span>Nuevas esta semana</span><strong>{createdThisWeek}</strong><small>Tareas capturadas</small></a>
        <a class="metric card" href="/?status=blocked"><span>Bloqueadas</span><strong>{blocked.length}</strong><small>Revisa qué las desbloquea</small></a>
        <a class="metric card" href="/"><span>Vencidas</span><strong>{overdue.length}</strong><small>Con fecha límite anterior a hoy</small></a>
      </section>
      <div class="weekly-grid">
        <section class="card completion-chart"><div class="section-heading"><div><h2>Completadas por día</h2><p class="muted">{selectedRange}</p></div><nav class="week-nav" aria-label="Semana de completadas"><a href={`/weekly?week=${dayKey(addDays(selectedWeekStart, -7))}`} aria-label="Semana anterior">←</a><a href="/weekly">Actual</a><a href={`/weekly?week=${dayKey(selectedWeekEnd)}`} aria-label="Semana siguiente">→</a></nav></div><div class="bars" role="img" aria-label={days.map((day) => `${day.label}: ${day.count}`).join(', ')}>{days.map((day) => <div class="bar-item"><strong>{day.count || ''}</strong><span class="bar-track"><i style={`--bar-height:${Math.max(5, day.count / maxDaily * 100)}%`}></i></span><small>{day.label}</small></div>)}</div></section>
        <section class="card dates-card"><h2>Fechas de esta semana <span class="muted">({dueThisWeek.length})</span></h2>{dueThisWeek.length ? <><ul class="task-list">{dueThisWeek.slice(0, 4).map((task) => <li><a href={`/tasks/${task.id}`}><strong>{task.title}</strong><small>{task.projectId ? projectNames.get(task.projectId) ?? 'Proyecto' : 'Inbox'} · {task.dueAt ? fmtDate(task.dueAt) : fmtDate(`${task.scheduledFor}T12:00:00`)}</small></a></li>)}</ul>{dueThisWeek.length > 4 && <button type="button" class="button secondary show-all-dates" id="show-all-dates">Ver todas ({dueThisWeek.length})</button>}</> : <p class="muted">No hay tareas próximas con fecha esta semana.</p>}</section>
        <section class="card history-chart"><h2>Completadas por semana</h2><div class="history-scroll"><svg viewBox="0 0 576 160" role="img" aria-label={weeklyHistory.map((week) => `${week.label}: ${week.count}`).join(', ')}><line x1="20" y1="124" x2="560" y2="124" class="chart-axis" /><polyline points={linePoints} class="chart-line" />{weeklyHistory.map((week, index) => <g><circle cx={36 + index * 72} cy={124 - week.count / historyMax * 100} r="5" class="chart-point" /><text x={36 + index * 72} y="149" text-anchor="middle">{week.label}</text><text x={36 + index * 72} y={Math.max(14, 113 - week.count / historyMax * 100)} text-anchor="middle">{week.count}</text></g>)}</svg></div></section>
        <section class="card"><h2>Bloqueadas <span class="muted">({blocked.length})</span></h2>{blocked.length ? <ul class="task-list">{blocked.slice(0, 8).map((task) => <li><a href={`/tasks/${task.id}`}><strong>{task.title}</strong><small>{projectNames.get(task.projectId ?? '') ?? 'Inbox'} · {task.blockedReason}</small></a></li>)}</ul> : <p class="muted">No hay tareas bloqueadas.</p>}</section>
        <section class="card"><h2>Vencidas <span class="muted">({overdue.length})</span></h2>{overdue.length ? <ul class="task-list">{overdue.slice(0, 8).map((task) => <li><a href={`/tasks/${task.id}`}><strong>{task.title}</strong><small>{projectNames.get(task.projectId ?? '') ?? 'Inbox'} · Venció {fmtDate(task.dueAt!)}</small></a></li>)}</ul> : <p class="muted">No hay tareas vencidas.</p>}</section>
      </div>
      <dialog class="dates-dialog" id="all-dates-dialog" aria-labelledby="all-dates-title"><div class="dialog-heading"><h2 id="all-dates-title">Fechas de esta semana</h2><button type="button" class="button secondary" id="close-all-dates">Cerrar</button></div><ul class="task-list">{dueThisWeek.map((task) => <li><a href={`/tasks/${task.id}`}><strong>{task.title}</strong><small>{task.projectId ? projectNames.get(task.projectId) ?? 'Proyecto' : 'Inbox'} · {task.dueAt ? fmtDate(task.dueAt) : fmtDate(`${task.scheduledFor}T12:00:00`)}</small></a></li>)}</ul></dialog>
    </>}
  </main>
</AppLayout>

<script>
  const datesDialog = document.querySelector<HTMLDialogElement>('#all-dates-dialog');
  document.querySelector('#show-all-dates')?.addEventListener('click', () => datesDialog?.showModal());
  document.querySelector('#close-all-dates')?.addEventListener('click', () => datesDialog?.close());
</script>

<style>
  .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8rem; }
  .metric { display: grid; gap: 0.35rem; color: inherit; text-decoration: none; }
  .metric:hover { border-color: var(--accent); }
  .metric span { color: var(--subtle); font-size: 0.88rem; }
  .metric strong { font-size: 2rem; line-height: 1.1; }
  .metric small { color: var(--subtle); }
  .weekly-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; margin-top: 1rem; }
  .weekly-grid > * { min-width: 0; }
  .completion-chart { grid-column: 1; grid-row: 1; min-height: 15rem; }
  .section-heading, .dialog-heading { display: flex; align-items: start; justify-content: space-between; gap: 0.75rem; }
  .section-heading h2, .dialog-heading h2 { margin-bottom: 0.3rem; }
  .section-heading p { margin: 0; }
  .week-nav { display: flex; gap: 0.25rem; flex-shrink: 0; }
  .week-nav a { padding: 0.35rem 0.5rem; border: 1px solid var(--border); border-radius: 0.4rem; text-decoration: none; }
  .dates-card { grid-column: 2; grid-row: 1; align-self: start; }
  .history-chart { grid-column: 1; grid-row: 2; }
  .show-all-dates { margin-top: 0.8rem; }
  .dates-dialog { width: min(36rem, calc(100% - 2rem)); max-height: min(80dvh, 44rem); overflow-y: auto; border: 1px solid var(--border); border-radius: 0.8rem; padding: 1.25rem; background: var(--surface); color: var(--text); }
  .dates-dialog::backdrop { background: rgb(0 0 0 / 0.55); }
  .history-scroll { max-width: 100%; overflow-x: auto; }
  .history-chart svg { display: block; width: 100%; min-width: 30rem; height: auto; }
  .chart-axis { stroke: var(--border); }
  .chart-line { fill: none; stroke: var(--accent-text); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .chart-point { fill: var(--accent-text); }
  .history-chart text { fill: var(--subtle); font-size: 10px; }
  .bars { display: flex; align-items: end; justify-content: space-around; gap: 0.5rem; height: 10rem; padding-top: 1rem; }
  .bar-item { display: grid; justify-items: center; align-items: end; gap: 0.3rem; height: 100%; min-width: 2rem; }
  .bar-item strong, .bar-item small { color: var(--subtle); font-size: 0.8rem; }
  .bar-track { display: flex; align-items: end; width: min(2.2rem, 7vw); height: 100%; border-radius: 0.4rem; background: var(--surface-muted); overflow: hidden; }
  .bar-track i { display: block; width: 100%; height: var(--bar-height); min-height: 0.2rem; border-radius: inherit; background: var(--accent-text); }
  .task-list { display: grid; gap: 0.2rem; list-style: none; padding: 0; margin: 0; }
  .task-list li + li { border-top: 1px solid var(--border); }
  .task-list a { display: grid; gap: 0.2rem; padding: 0.65rem 0; color: inherit; text-decoration: none; }
  .task-list a:hover strong { color: var(--accent-text); }
  .task-list small { color: var(--subtle); }
  @media (max-width: 850px) { .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 650px) {
    .weekly-grid { grid-template-columns: minmax(0, 1fr); }
    .dates-card { grid-column: 1; grid-row: 3; }
    .section-heading { flex-wrap: wrap; }
    .history-chart svg { min-width: 28rem; }
  }
</style>
