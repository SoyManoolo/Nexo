---
import AppLayout from '../../layouts/AppLayout.astro';
import { createApiClient } from '../../lib/api';
import { formError } from '../../lib/form-error';
import { formValue } from '../../lib/form-value';
import { isSameOrigin } from '../../lib/security';
import { NexoApiNotFoundError } from '@nexo/api-client';
import type { Project, Task } from '@nexo/contracts';

const id = Astro.params.id ?? '';
let project: Project | null = null;
let tasks: Task[] = [];
let errorMessage: string | null = null;
let submittedForm: FormData | null = null;
let notFound = false;
const statusParam = Astro.url.searchParams.get('status');
const priorityParam = Astro.url.searchParams.get('priority');
const statusFilter = ['inbox', 'next', 'in_progress', 'blocked', 'done'].includes(statusParam ?? '')
  ? statusParam as Task['status']
  : undefined;
const priorityFilter = ['low', 'medium', 'high'].includes(priorityParam ?? '')
  ? priorityParam as Task['priority']
  : undefined;
const taskView = Astro.url.searchParams.get('view') === 'list' ? 'list' : 'board';
const taskStatuses: Array<{ value: Task['status']; label: string }> = [
  { value: 'inbox', label: 'Inbox' },
  { value: 'next', label: 'Siguiente' },
  { value: 'in_progress', label: 'En curso' },
  { value: 'blocked', label: 'Bloqueada' },
  { value: 'done', label: 'Completada' },
];

function taskViewHref(view: 'board' | 'list'): string {
  const params = new URLSearchParams();
  if (statusFilter) params.set('status', statusFilter);
  if (priorityFilter) params.set('priority', priorityFilter);
  if (view === 'list') params.set('view', 'list');
  const query = params.toString();
  return `/projects/${id}${query ? `?${query}` : ''}`;
}

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request, Astro.url)) {
    return new Response('Origen no permitido', { status: 403 });
  }
  const form = await Astro.request.formData();
  submittedForm = form;
  const intent = String(form.get('intent') ?? '');
  try {
    const api = createApiClient();
    if (intent === 'update') {
      await api.updateProject(id, {
        name: String(form.get('name') ?? ''),
        description: String(form.get('description') ?? '') || null,
        color: String(form.get('color') ?? '') || null,
      });
    } else if (intent === 'archive') {
      await api.archiveProject(id);
      return Astro.redirect('/projects?status=archived', 303);
    } else if (intent === 'delete') {
      await api.deleteProject(id);
      return Astro.redirect('/projects', 303);
    } else if (intent === 'move-task') {
      const taskId = String(form.get('taskId') ?? '');
      const targetStatus = String(form.get('targetStatus') ?? '');
      const blockedReason = String(form.get('blockedReason') ?? '').trim();
      if (!['inbox', 'next', 'in_progress', 'blocked', 'done'].includes(targetStatus)) {
        throw new Error('Estado de destino no válido');
      }
      const task = await api.getTask(taskId);
      if (task.projectId !== id) throw new Error('La tarea no pertenece a este proyecto');
      await api.updateTask(taskId, {
        status: targetStatus as Task['status'],
        completedAt: targetStatus === 'done' ? task.completedAt ?? new Date().toISOString() : null,
        blockedReason: targetStatus === 'blocked' ? blockedReason : null,
      });
      return Astro.redirect(`/projects/${id}`, 303);
    } else if (intent === 'create-task') {
      const dueAt = String(form.get('dueAt') ?? '');
      const dueAtIso = String(form.get('dueAtIso') ?? '');
      await api.createTask({
        title: String(form.get('title') ?? ''),
        notes: String(form.get('notes') ?? '') || null,
        priority: String(form.get('priority') ?? 'medium') as Task['priority'],
        scheduledFor: String(form.get('scheduledFor') ?? '') || null,
        dueAt: dueAt ? dueAtIso || new Date(dueAt).toISOString() : null,
        projectId: id,
      });
    } else {
      throw new Error('Acción desconocida');
    }
    return Astro.redirect(`/projects/${id}`, 303);
  } catch (error) {
    console.error('No se pudo guardar el proyecto:', error);
    const failure = formError(error, 'No se pudieron guardar los cambios. Revisa los datos e inténtalo de nuevo.');
    errorMessage = failure.message;
    Astro.response.status = failure.status;
  }
}

try {
  const api = createApiClient();
  project = await api.getProject(id);
} catch (error) {
  if (error instanceof NexoApiNotFoundError) {
    notFound = true;
    Astro.response.status = 404;
  } else {
    console.error('No se pudo cargar el proyecto:', error);
    errorMessage ??= 'No se pudo cargar el proyecto. Comprueba la conexión con la API.';
  }
}

if (project) {
  try {
    tasks = await createApiClient().listTasks({ projectId: id, status: statusFilter, priority: priorityFilter });
  } catch (error) {
    console.error('No se pudieron cargar las tareas del proyecto:', error);
    errorMessage ??= 'El proyecto está disponible, pero no se pudieron cargar sus tareas.';
  }
}

const updateForm = submittedForm?.get('intent') === 'update' ? submittedForm : null;
const taskForm = submittedForm?.get('intent') === 'create-task' ? submittedForm : null;
---

<AppLayout title={project ? `${project.name} · Nexo` : 'Proyecto · Nexo'} section="projects">
  <main class="page project-page">
    <a class="back-link" href="/projects">← Todos los proyectos</a>
    {notFound ? (
      <div class="notice"><h1>Proyecto no encontrado</h1><p>Puede que haya sido eliminado o que el enlace no sea correcto.</p></div>
    ) : project ? (
      <>
        <header class="page-header">
          <div>
            <p class="eyebrow">{project.status === 'archived' ? 'Proyecto archivado' : 'Proyecto activo'}</p>
            <h1>{project.name}</h1>
            {project.description && <p class="page-intro">{project.description}</p>}
          </div>
          <div class="project-actions">
            <button class="button secondary" type="button" id="open-project-modal">Detalles del proyecto</button>
            {project.status === 'active' && <button class="button" type="button" id="open-task-modal">Añadir tarea</button>}
          </div>
        </header>
        {errorMessage && <div class="notice error" role="alert"><p>{errorMessage}</p></div>}
        <section aria-labelledby="tasks-heading">
            <div class="tasks-header">
              <h2 id="tasks-heading">Tareas <span class="muted">({tasks.length})</span></h2>
              <nav class="view-switcher" aria-label="Vista de tareas">
                <a href={taskViewHref('board')} aria-current={taskView === 'board' ? 'page' : undefined}>Columnas</a>
                <a href={taskViewHref('list')} aria-current={taskView === 'list' ? 'page' : undefined}>Filas</a>
              </nav>
            </div>
            <form method="get" class="filters" data-filter-form>
              {taskView === 'list' && <input type="hidden" name="view" value="list" />}
              <label class="field">Estado
                <select name="status">
                  <option value="">Todos</option>
                  <option value="inbox" selected={statusFilter === 'inbox'}>Inbox</option>
                  <option value="next" selected={statusFilter === 'next'}>Siguiente</option>
                  <option value="in_progress" selected={statusFilter === 'in_progress'}>En curso</option>
                  <option value="blocked" selected={statusFilter === 'blocked'}>Bloqueada</option>
                  <option value="done" selected={statusFilter === 'done'}>Completada</option>
                </select>
              </label>
              <label class="field">Prioridad
                <select name="priority">
                  <option value="">Todas</option>
                  <option value="low" selected={priorityFilter === 'low'}>Baja</option>
                  <option value="medium" selected={priorityFilter === 'medium'}>Media</option>
                  <option value="high" selected={priorityFilter === 'high'}>Alta</option>
                </select>
              </label>
            </form>
            {taskView === 'list' && tasks.length === 0 ? (
              <div class="notice"><p>{statusFilter || priorityFilter ? 'No hay tareas con estos filtros.' : 'Este proyecto todavía no tiene tareas.'}</p></div>
            ) : taskView === 'list' ? (
              <ul class="task-list">
                {tasks.map((task) => (
                  <li><a class="card task-link" href={`/tasks/${task.id}`}><span>{task.title}</span><small>{task.status.replace('_', ' ')} · {task.priority}</small></a></li>
                ))}
              </ul>
            ) : (
              <div class="task-board" aria-label="Tareas por estado">
                {taskStatuses.map(({ value, label }) => {
                  const columnTasks = tasks.filter((task) => task.status === value);
                  return (
                    <section class="task-column" aria-labelledby={`status-${value}`} data-task-column data-status={value}>
                      <h3 id={`status-${value}`}>{label} <span class="muted">({columnTasks.length})</span></h3>
                      {columnTasks.length === 0 ? (
                        <p class="empty-column">Sin tareas</p>
                      ) : (
                        <ul class="task-list">
                          {columnTasks.map((task) => (
                            <li><a class="card task-link board-task-link" href={`/tasks/${task.id}`} draggable="true" data-task-card data-task-id={task.id}><span>{task.title}</span><small>{task.priority}</small></a></li>
                          ))}
                        </ul>
                      )}
                    </section>
                  );
                })}
              </div>
            )}
          {project.status === 'active' && (
              <>
                <dialog class="task-modal" id="task-modal" aria-labelledby="task-modal-title" open={Boolean(taskForm)}>
                  <form method="post" class="quick-add" id="project-task-form">
                    <input type="hidden" name="intent" value="create-task" />
                    <div class="modal-header">
                      <h2 id="task-modal-title">Añadir tarea</h2>
                      <button class="modal-close" type="button" id="close-task-modal" aria-label="Cerrar">×</button>
                    </div>
                    <label class="field">Nueva tarea <input name="title" required maxlength="200" placeholder="¿Qué hay que hacer?" value={formValue(taskForm, 'title')} autofocus /></label>
                    <label class="field">Notas <textarea name="notes" maxlength="2000" placeholder="Detalles opcionales">{formValue(taskForm, 'notes')}</textarea></label>
                    <div class="quick-fields">
                      <label class="field">Prioridad <select name="priority"><option value="medium" selected={formValue(taskForm, 'priority', 'medium') === 'medium'}>Media</option><option value="low" selected={formValue(taskForm, 'priority') === 'low'}>Baja</option><option value="high" selected={formValue(taskForm, 'priority') === 'high'}>Alta</option></select></label>
                      <label class="field">Programada para <input name="scheduledFor" type="date" value={formValue(taskForm, 'scheduledFor')} /></label>
                      <label class="field">Fecha límite <input name="dueAt" type="datetime-local" value={formValue(taskForm, 'dueAt')} /></label>
                      <input name="dueAtIso" type="hidden" />
                    </div>
                    <div class="modal-actions">
                      <button class="button secondary" type="button" id="cancel-task-modal">Cancelar</button>
                      <button class="button" type="submit">Añadir tarea</button>
                    </div>
                  </form>
                </dialog>
              </>
            )}
        </section>
        <dialog class="task-modal project-modal" id="project-modal" aria-labelledby="project-modal-title" open={Boolean(updateForm)}>
          <form method="post" class="quick-add">
            <div class="modal-header">
              <h2 id="project-modal-title">Detalles del proyecto</h2>
              <button class="modal-close" type="button" id="close-project-modal" aria-label="Cerrar">×</button>
            </div>
            <div class="form-grid">
              <input type="hidden" name="intent" value="update" />
              <label class="field">Nombre <input name="name" required maxlength="120" value={formValue(updateForm, 'name', project.name)} /></label>
              <label class="field">Descripción <textarea name="description" maxlength="2000">{formValue(updateForm, 'description', project.description ?? '')}</textarea></label>
              <label class="field">Color <input name="color" type="color" value={formValue(updateForm, 'color', project.color ?? '#4d8564')} /></label>
              <button class="button secondary" type="submit">Guardar cambios</button>
            </div>
          </form>
          {project.status === 'active' && (
            <details class="archive-panel">
              <summary>Archivar proyecto</summary>
              <p>Seguirás pudiendo consultarlo en la lista de archivados.</p>
              <form method="post"><button class="button danger" name="intent" value="archive" type="submit">Confirmar archivado</button></form>
            </details>
          )}
          <form method="post" class="delete-panel" onsubmit="return confirm('¿Eliminar este proyecto? Las tareas se moverán al inbox y no se podrá deshacer.')">
            <input type="hidden" name="intent" value="delete" />
            <button class="button danger" type="submit">Eliminar proyecto</button>
          </form>
        </dialog>
        <dialog class="task-modal" id="block-reason-modal" aria-labelledby="block-reason-title">
          <form class="quick-add" id="block-reason-form">
            <div class="modal-header">
              <h2 id="block-reason-title">Motivo del bloqueo</h2>
              <button class="modal-close" type="button" id="close-block-reason-modal" aria-label="Cerrar">×</button>
            </div>
            <label class="field">¿Qué impide avanzar?
              <textarea id="block-reason" required maxlength="2000" placeholder="Describe el bloqueo"></textarea>
            </label>
            <div class="modal-actions">
              <button class="button secondary" type="button" id="cancel-block-reason-modal">Cancelar</button>
              <button class="button" type="submit">Bloquear tarea</button>
            </div>
          </form>
        </dialog>
      </>
    ) : (
      <div class="notice error" role="alert"><h1>Proyecto no disponible</h1><p>{errorMessage}</p><a href="/projects">Volver a intentar</a></div>
    )}
  </main>
</AppLayout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-filter-form]');
  filterForm?.addEventListener('change', (event) => {
    if (event.target instanceof HTMLSelectElement) filterForm.requestSubmit();
  });

  const taskModal = document.querySelector<HTMLDialogElement>('#task-modal');
  const projectModal = document.querySelector<HTMLDialogElement>('#project-modal');
  const openTaskModal = document.querySelector<HTMLButtonElement>('#open-task-modal');
  const openProjectModal = document.querySelector<HTMLButtonElement>('#open-project-modal');
  const closeTaskModal = document.querySelector<HTMLButtonElement>('#close-task-modal');
  const closeProjectModal = document.querySelector<HTMLButtonElement>('#close-project-modal');
  const cancelTaskModal = document.querySelector<HTMLButtonElement>('#cancel-task-modal');
  const taskForm = document.querySelector<HTMLFormElement>('#project-task-form');
  const blockReasonModal = document.querySelector<HTMLDialogElement>('#block-reason-modal');
  const blockReasonForm = document.querySelector<HTMLFormElement>('#block-reason-form');
  const blockReason = document.querySelector<HTMLTextAreaElement>('#block-reason');
  const closeBlockReasonModal = document.querySelector<HTMLButtonElement>('#close-block-reason-modal');
  const cancelBlockReasonModal = document.querySelector<HTMLButtonElement>('#cancel-block-reason-modal');

  openTaskModal?.addEventListener('click', () => taskModal?.showModal());
  openProjectModal?.addEventListener('click', () => projectModal?.showModal());
  closeTaskModal?.addEventListener('click', () => taskModal?.close());
  closeProjectModal?.addEventListener('click', () => projectModal?.close());
  cancelTaskModal?.addEventListener('click', () => taskModal?.close());
  taskForm?.addEventListener('submit', () => {
    const dueAt = taskForm.elements.namedItem('dueAt') as HTMLInputElement | null;
    const dueAtIso = taskForm.elements.namedItem('dueAtIso') as HTMLInputElement | null;
    if (dueAtIso && dueAt) dueAtIso.value = dueAt.value ? new Date(dueAt.value).toISOString() : '';
  });

  let draggedTask: HTMLElement | null = null;
  let pendingBlockedTaskId: string | null = null;

  async function moveTask(taskId: string, targetStatus: string, blockedReason = ''): Promise<void> {
    const form = new FormData();
    form.set('intent', 'move-task');
    form.set('taskId', taskId);
    form.set('targetStatus', targetStatus);
    form.set('blockedReason', blockedReason);
    const response = await fetch(window.location.pathname, { method: 'POST', body: form });
    if (response.redirected) window.location.assign(response.url);
  }

  function closeBlockedReasonModal(): void {
    pendingBlockedTaskId = null;
    blockReasonForm?.reset();
    blockReasonModal?.close();
  }

  closeBlockReasonModal?.addEventListener('click', closeBlockedReasonModal);
  cancelBlockReasonModal?.addEventListener('click', closeBlockedReasonModal);
  blockReasonForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const reason = blockReason?.value.trim() ?? '';
    if (!pendingBlockedTaskId || !reason) return;
    await moveTask(pendingBlockedTaskId, 'blocked', reason);
  });

  document.querySelectorAll<HTMLElement>('[data-task-card]').forEach((card) => {
    card.addEventListener('dragstart', (event) => {
      draggedTask = card;
      event.dataTransfer?.setData('text/plain', card.dataset.taskId ?? '');
      if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
    });
    card.addEventListener('dragend', () => { draggedTask = null; });
  });
  document.querySelectorAll<HTMLElement>('[data-task-column]').forEach((column) => {
    column.addEventListener('dragover', (event) => {
      event.preventDefault();
      column.classList.add('is-drop-target');
    });
    column.addEventListener('dragleave', () => column.classList.remove('is-drop-target'));
    column.addEventListener('drop', async (event) => {
      event.preventDefault();
      column.classList.remove('is-drop-target');
      const taskId = event.dataTransfer?.getData('text/plain') ?? draggedTask?.dataset.taskId;
      const targetStatus = column.dataset.status;
      if (!taskId || !targetStatus) return;
      if (targetStatus === 'blocked') {
        pendingBlockedTaskId = taskId;
        blockReasonModal?.showModal();
        blockReason?.focus();
        return;
      }
      await moveTask(taskId, targetStatus);
    });
  });
</script>

<style>
  .back-link { display: inline-block; margin-bottom: 1.5rem; color: #316d4b; font-weight: 650; text-decoration: none; }
  h2 { margin: 0 0 1rem; font-size: 1.2rem; }
  .tasks-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .project-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 0.65rem; }
  .view-switcher { display: inline-flex; overflow: hidden; border: 1px solid #b9c8bb; border-radius: 0.5rem; }
  .view-switcher a { padding: 0.38rem 0.65rem; color: #316d4b; font-size: 0.88rem; font-weight: 700; text-decoration: none; }
  .view-switcher a + a { border-left: 1px solid #b9c8bb; }
  .view-switcher a[aria-current='page'] { background: #316d4b; color: #fff; }
  .task-list { display: grid; gap: 0.65rem; padding: 0; margin: 0; list-style: none; }
  .filters { display: flex; align-items: end; gap: 0.6rem; margin-bottom: 1rem; }
  .filters .field { flex: 0 1 12rem; }
  .task-link { display: flex; justify-content: space-between; gap: 1rem; text-decoration: none; }
  .task-link:hover { border-color: #7faa8c; }
  .task-link small { flex: none; color: #58665c; }
  .task-board { display: grid; grid-template-columns: repeat(5, minmax(11rem, 1fr)); align-items: stretch; gap: 0.8rem; min-height: max(24rem, calc(100vh - 22rem)); overflow-x: auto; padding-bottom: 0.4rem; }
  .task-column { min-width: 0; border: 1px solid #dce2da; border-radius: 0.7rem; padding: 0.8rem; background: #f7faf7; transition: border-color 150ms ease, background 150ms ease; }
  .task-column.is-drop-target { border-color: #3d7655; background: #edf5ee; }
  .task-column h3 { margin: 0 0 0.75rem; color: #365440; font-size: 0.95rem; }
  .task-column .task-list { gap: 0.5rem; }
  .board-task-link { display: grid; gap: 0.35rem; }
  .empty-column { margin: 0; color: #758177; font-size: 0.9rem; }
  .task-modal { width: min(36rem, calc(100% - 2rem)); border: 0; border-radius: 0.9rem; padding: 0; box-shadow: 0 1.5rem 4rem rgb(25 45 32 / 0.3); }
  .task-modal::backdrop { background: rgb(20 35 25 / 0.45); }
  .project-modal { width: min(38rem, calc(100% - 2rem)); }
  .project-modal .field textarea { min-height: 4.5rem; }
  .quick-add { display: grid; gap: 0.8rem; padding: 1.25rem; }
  .modal-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .modal-header h2 { margin: 0; }
  .modal-close { border: 0; border-radius: 0.4rem; padding: 0.1rem 0.45rem; background: transparent; color: #58665c; cursor: pointer; font-size: 1.8rem; line-height: 1; }
  .modal-close:hover { background: #edf5ee; color: #27583b; }
  .quick-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 0.65rem; }
  .archive-panel { margin: 0; border-top: 1px solid #dce2da; padding: 1rem 1.25rem; }
  .archive-panel summary { cursor: pointer; color: #9b382c; font-weight: 700; }
  .archive-panel p { color: #58665c; line-height: 1.5; }
  .delete-panel { border-top: 1px solid #dce2da; padding: 1rem 1.25rem 1.25rem; }
  @media (max-width: 600px) { .project-actions, .tasks-header, .task-link, .filters { flex-direction: column; align-items: stretch; } .view-switcher { align-self: flex-start; } .quick-fields { grid-template-columns: 1fr; } }
</style>
