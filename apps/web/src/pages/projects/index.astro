---
import AppLayout from '../../layouts/AppLayout.astro';
import { NexoApiError, NexoApiResponseValidationError, NexoApiTimeoutError } from '@nexo/api-client';
import { createApiClient } from '../../lib/api';
import { formError } from '../../lib/form-error';
import { formValue } from '../../lib/form-value';
import { isSameOrigin } from '../../lib/security';
import type { GithubRepository, Project, Task } from '@nexo/contracts';

let projects: Project[] = [];
let archived: Project[] = [];
let tasks: Task[] = [];
let githubRepositories: GithubRepository[] = [];
let githubListError: string | null = null;
let errorMessage: string | null = null;
let submittedForm: FormData | null = null;
const showArchived = Astro.url.searchParams.get('status') === 'archived';
const showGithubImport = Astro.url.searchParams.get('import') === 'github';

function apiLoadErrorMessage(error: unknown): string {
  if (error instanceof NexoApiResponseValidationError) {
    return 'La API responde, pero sus datos no coinciden con esta versión de Nexo. Comprueba que las migraciones estén aplicadas y reinicia la API.';
  }
  if (error instanceof NexoApiTimeoutError) return error.message;
  if (error instanceof NexoApiError) return error.message;
  if (error instanceof Error && error.message.includes('API_BASE_URL')) return error.message;
  return 'No hemos podido conectar con la API. Comprueba que esté en marcha y vuelve a intentarlo.';
}

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request, Astro.url)) {
    return new Response('Origen no permitido', { status: 403 });
  }
  const form = await Astro.request.formData();
  submittedForm = form;
  try {
    const intent = String(form.get('intent') ?? '');
    if (intent === 'archive-project' || intent === 'delete-project') {
      const api = createApiClient();
      const projectId = String(form.get('projectId') ?? '');
      const project = await api.getProject(projectId);
      if (String(form.get('confirmName') ?? '') !== project.name) {
        throw new RangeError('Escribe el nombre exacto del proyecto para confirmar.');
      }
      if (intent === 'archive-project') {
        if (project.status !== 'active') throw new Error('El proyecto ya está archivado.');
        await api.archiveProject(projectId);
        return Astro.redirect('/projects?status=archived', 303);
      }
      await api.deleteProject(projectId);
      return Astro.redirect(showArchived ? '/projects?status=archived' : '/projects', 303);
    }
    if (intent === 'restore-project') {
      await createApiClient().restoreProject(String(form.get('projectId') ?? ''));
      return Astro.redirect('/projects', 303);
    }
    if (intent === 'import-github') {
      const repository = String(form.get('repository') ?? '');
      const project = await createApiClient().importGithubProject({ repositoryUrl: `https://github.com/${repository}` });
      return Astro.redirect(`/projects/${project.id}`, 303);
    }
    await createApiClient().createProject({
      name: String(form.get('name') ?? ''),
      description: String(form.get('description') ?? '') || null,
      color: String(form.get('color') ?? '') || null,
    });
    return Astro.redirect('/projects', 303);
  } catch (error) {
    console.error('No se pudo guardar el proyecto:', error);
    const failure = formError(error, 'No se pudo guardar el proyecto. Revisa los datos e inténtalo de nuevo.');
    errorMessage = failure.message;
    if (error instanceof RangeError) errorMessage = error.message;
    Astro.response.status = failure.status;
  }
}

if (showGithubImport) {
  try { githubRepositories = await createApiClient().listGithubRepositories(); }
  catch (error) {
    console.error('No se pudieron cargar los repositorios de GitHub:', error);
    githubListError = error instanceof Error ? error.message : 'No se pudieron cargar los repositorios. Revisa la conexión en Ajustes.';
  }
}

const apiClient = Promise.resolve().then(createApiClient);
const [activeProjectsResult, archivedProjectsResult, tasksResult] = await Promise.allSettled([
  apiClient.then((client) => client.listProjects({ status: 'active' })),
  apiClient.then((client) => client.listProjects({ status: 'archived' })),
  apiClient.then((client) => client.listTasks()),
]);
const loadErrors: string[] = [];

if (activeProjectsResult.status === 'fulfilled') projects = activeProjectsResult.value;
else {
  console.error('No se pudieron cargar los proyectos activos:', activeProjectsResult.reason);
  loadErrors.push(apiLoadErrorMessage(activeProjectsResult.reason));
}

if (archivedProjectsResult.status === 'fulfilled') archived = archivedProjectsResult.value;
else {
  console.error('No se pudieron cargar los proyectos archivados:', archivedProjectsResult.reason);
  loadErrors.push(apiLoadErrorMessage(archivedProjectsResult.reason));
}

if (tasksResult.status === 'fulfilled') tasks = tasksResult.value;
else {
  console.error('No se pudieron cargar las tareas:', tasksResult.reason);
  loadErrors.push(apiLoadErrorMessage(tasksResult.reason));
}

if (loadErrors.length > 0) errorMessage ??= [...new Set(loadErrors)].join(' ');

const visibleProjects = showArchived ? archived : projects;
const attemptedAction = String(submittedForm?.get('intent') ?? '');
const actionProject = [...projects, ...archived].find((project) => project.id === submittedForm?.get('projectId'));
const taskSummariesByProject = new Map<string, { total: number; completed: number; blocked: number; overdue: number }>();
for (const task of tasks) {
  if (!task.projectId) continue;
  const summary = taskSummariesByProject.get(task.projectId) ?? { total: 0, completed: 0, blocked: 0, overdue: 0 };
  summary.total += 1;
  if (task.status === 'done') summary.completed += 1;
  if (task.status === 'blocked') summary.blocked += 1;
  if (task.status !== 'done' && task.dueAt && Date.parse(task.dueAt) < Date.now()) summary.overdue += 1;
  taskSummariesByProject.set(task.projectId, summary);
}
---

<AppLayout title="Proyectos · Nexo" section="projects">
  <main class="page">
    <header class="page-header">
      <div>
        <p class="eyebrow">Tu espacio</p>
        <h1>Proyectos</h1>
        <p class="page-intro">Todo lo que tienes entre manos, en un solo lugar.</p>
      </div>
      <div class="project-header-actions">
        <button class="button" type="button" id="open-project-modal">Crear proyecto</button>
        <a class="button secondary" href="/projects?import=github">Importar desde GitHub</a>
      </div>
    </header>

    {errorMessage && <div class="notice error" role="alert"><p>{errorMessage}</p><a href="/projects">Volver a intentar</a></div>}

    <section aria-label="Lista de proyectos">
        <div class="tabs">
          <a href="/projects" aria-current={!showArchived ? 'page' : undefined}>Activos ({projects.length})</a>
          <a href="/projects?status=archived" aria-current={showArchived ? 'page' : undefined}>Archivados ({archived.length})</a>
        </div>
        {!errorMessage && visibleProjects.length === 0 && (
          <div class="notice"><h2>{showArchived ? 'No hay proyectos archivados' : 'Aún no tienes proyectos'}</h2><p>{showArchived ? 'Los proyectos que archives aparecerán aquí.' : 'Crea tu primer proyecto con el formulario.'}</p></div>
        )}
        <ul class="projects">
          {visibleProjects.map((project) => (
            <li class="project-item card">
              <a class="project" href={`/projects/${project.id}`}>
                <span class="project-color" style={`background-color: ${project.color ?? '#4d8564'}`} aria-hidden="true"></span>
                <span><strong>{project.name}</strong>{project.description && <small>{project.description}</small>}</span>
                {(() => {
                  const summary = taskSummariesByProject.get(project.id) ?? { total: 0, completed: 0, blocked: 0, overdue: 0 };
                  const progress = summary.total ? Math.round((summary.completed / summary.total) * 100) : 0;
                  return <span class="project-overview"><span class="project-overview-label">{summary.total - summary.completed} abiertas · {summary.blocked} bloqueadas · {summary.overdue} vencidas</span><span class="project-progress-label">{progress}%</span><progress value={progress} max="100" aria-label={`${progress}% completado`} /></span>;
                })()}
                <span aria-hidden="true">→</span>
              </a>
              {showArchived && <form method="post" class="restore-project-form">
                <input type="hidden" name="intent" value="restore-project" />
                <input type="hidden" name="projectId" value={project.id} />
                <button class="button secondary" type="submit" aria-label={`Restaurar ${project.name}`}>Restaurar</button>
              </form>}
              <details class="project-menu">
                <summary aria-label={`Opciones de ${project.name}`} title={`Opciones de ${project.name}`}>⋯</summary>
                <div class="project-menu-options">
                  {project.status === 'active' && <button type="button" data-project-action="archive" data-project-id={project.id} data-project-name={project.name}>Archivar proyecto</button>}
                  <button type="button" data-project-action="delete" data-project-id={project.id} data-project-name={project.name}>Eliminar proyecto</button>
                </div>
              </details>
            </li>
          ))}
        </ul>
    </section>
    <dialog class="project-modal" id="project-modal" aria-labelledby="create-project-heading" data-auto-open={submittedForm?.get('intent') === 'create-project' ? 'true' : undefined}>
      <form method="post" class="form-grid">
        <input type="hidden" name="intent" value="create-project" />
        <div class="modal-header"><h2 id="create-project-heading">Nuevo proyecto</h2><button class="modal-close" type="button" id="close-project-modal" aria-label="Cerrar">×</button></div>
            <label class="field">Nombre <input name="name" required maxlength="120" autocomplete="off" value={formValue(submittedForm, 'name')} /></label>
            <label class="field">Descripción <textarea name="description" maxlength="2000">{formValue(submittedForm, 'description')}</textarea></label>
            <label class="field">Color <input name="color" type="color" value={formValue(submittedForm, 'color', '#4d8564')} /></label>
        <div class="modal-actions"><button class="button secondary" type="button" id="cancel-project-modal">Cancelar</button><button class="button" type="submit">Crear proyecto</button></div>
      </form>
    </dialog>
    <dialog class="project-modal" id="project-action-modal" aria-labelledby="project-action-title" data-auto-open={['archive-project', 'delete-project'].includes(attemptedAction) ? 'true' : undefined}>
      <form method="post" class="form-grid" id="project-action-form">
        <input type="hidden" name="intent" id="project-action-intent" value={formValue(submittedForm, 'intent')} />
        <input type="hidden" name="projectId" id="project-action-id" value={formValue(submittedForm, 'projectId')} />
        <div class="modal-header"><h2 id="project-action-title">{attemptedAction === 'archive-project' ? 'Archivar proyecto' : attemptedAction === 'delete-project' ? 'Eliminar proyecto' : 'Confirmar acción'}</h2><button class="modal-close" type="button" id="close-project-action-modal" aria-label="Cerrar">×</button></div>
        <p id="project-action-description">{attemptedAction === 'archive-project' ? 'Podrás restaurar el proyecto más adelante.' : attemptedAction === 'delete-project' ? 'Las tareas pasarán al inbox. Esta acción no se puede deshacer.' : ''}</p>
        <label class="field">Escribe el nombre exacto del proyecto: <strong id="project-action-name">{actionProject?.name}</strong>
          <input name="confirmName" id="project-action-confirm-name" required autocomplete="off" value={formValue(submittedForm, 'confirmName')} />
        </label>
        <div class="modal-actions"><button class="button secondary" type="button" id="cancel-project-action-modal">Cancelar</button><button class="button danger" type="submit" id="confirm-project-action">{attemptedAction === 'archive-project' ? 'Archivar proyecto' : attemptedAction === 'delete-project' ? 'Eliminar proyecto' : 'Confirmar'}</button></div>
      </form>
    </dialog>
    <dialog class="project-modal" id="github-modal" aria-labelledby="github-import-heading" data-auto-open={showGithubImport || submittedForm?.get('intent') === 'import-github' ? 'true' : undefined}>
      <form method="post" class="form-grid">
        <input type="hidden" name="intent" value="import-github" />
        <div class="modal-header"><h2 id="github-import-heading">Elige un repositorio</h2><a class="modal-close" href="/projects" aria-label="Cerrar">×</a></div>
        <p class="muted">Selecciona un repositorio accesible por la conexión configurada en Ajustes.</p>
        {githubListError ? <div class="notice error" role="alert"><p>{githubListError}</p><a href="/settings">Configurar GitHub en Ajustes</a></div> : githubRepositories.length === 0 ? <div class="notice"><p>No se encontraron repositorios accesibles.</p></div> : (
          <label class="field">Repositorio
            <select name="repository" required>
              {githubRepositories.map((repository) => <option value={repository.fullName} selected={formValue(submittedForm, 'repository') === repository.fullName}>{repository.fullName}{repository.isPrivate ? ' · Privado' : ''}</option>)}
            </select>
          </label>
        )}
        <div class="modal-actions"><a class="button secondary" href="/projects">Cancelar</a><button class="button" type="submit" disabled={githubRepositories.length === 0}>Importar proyecto</button></div>
      </form>
    </dialog>
  </main>
</AppLayout>

<script>
  const projectModal = document.querySelector<HTMLDialogElement>('#project-modal');
  const githubModal = document.querySelector<HTMLDialogElement>('#github-modal');
  const openProjectModal = document.querySelector<HTMLButtonElement>('#open-project-modal');
  const closeProjectModal = document.querySelector<HTMLButtonElement>('#close-project-modal');
  const cancelProjectModal = document.querySelector<HTMLButtonElement>('#cancel-project-modal');
  const actionModal = document.querySelector<HTMLDialogElement>('#project-action-modal');
  const actionIntent = document.querySelector<HTMLInputElement>('#project-action-intent');
  const actionId = document.querySelector<HTMLInputElement>('#project-action-id');
  const actionName = document.querySelector<HTMLElement>('#project-action-name');
  const actionInput = document.querySelector<HTMLInputElement>('#project-action-confirm-name');
  const actionTitle = document.querySelector<HTMLElement>('#project-action-title');
  const actionDescription = document.querySelector<HTMLElement>('#project-action-description');
  const actionSubmit = document.querySelector<HTMLButtonElement>('#confirm-project-action');
  if (projectModal?.dataset.autoOpen === 'true') projectModal.showModal();
  if (githubModal?.dataset.autoOpen === 'true') githubModal.showModal();
  if (actionModal?.dataset.autoOpen === 'true') actionModal.showModal();
  openProjectModal?.addEventListener('click', () => projectModal?.showModal());
  closeProjectModal?.addEventListener('click', () => projectModal?.close());
  cancelProjectModal?.addEventListener('click', () => projectModal?.close());
  document.querySelectorAll<HTMLButtonElement>('[data-project-action]').forEach((button) => button.addEventListener('click', () => {
    const action = button.dataset.projectAction;
    const name = button.dataset.projectName ?? '';
    if (!actionIntent || !actionId || !actionName || !actionInput || !actionTitle || !actionDescription || !actionSubmit) return;
    actionIntent.value = `${action}-project`;
    actionId.value = button.dataset.projectId ?? '';
    actionName.textContent = name;
    actionInput.value = '';
    actionTitle.textContent = action === 'archive' ? 'Archivar proyecto' : 'Eliminar proyecto';
    actionDescription.textContent = action === 'archive'
      ? 'Podrás restaurar el proyecto más adelante.'
      : 'Las tareas pasarán al inbox. Esta acción no se puede deshacer.';
    actionSubmit.textContent = action === 'archive' ? 'Archivar proyecto' : 'Eliminar proyecto';
    button.closest('details')?.removeAttribute('open');
    actionModal?.showModal();
    actionInput.focus();
  }));
  document.querySelector('#close-project-action-modal')?.addEventListener('click', () => actionModal?.close());
  document.querySelector('#cancel-project-action-modal')?.addEventListener('click', () => actionModal?.close());
</script>

<style>
  .project-header-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .tabs { display: flex; gap: 1rem; margin-bottom: 1rem; border-bottom: 1px solid #dce2da; }
  .tabs a { padding: 0.6rem 0.2rem; text-decoration: none; color: #58665c; }
  .tabs a[aria-current="page"] { border-bottom: 2px solid #316d4b; color: #173a27; font-weight: 700; }
  .projects { display: grid; gap: 0.7rem; padding: 0; margin: 0; list-style: none; }
  .project-item { display: flex; align-items: center; gap: 0.65rem; }
  .project { display: flex; flex: 1; min-width: 0; align-items: center; gap: 0.9rem; text-decoration: none; }
  .restore-project-form { flex: none; }
  .project-menu { position: relative; flex: none; }
  .project-menu summary { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 1px solid var(--border); border-radius: 0.6rem; background: var(--surface); color: var(--text); font-size: 1.5rem; line-height: 1; cursor: pointer; list-style: none; }
  .project-menu summary::-webkit-details-marker { display: none; }
  .project-menu-options { position: absolute; z-index: 2; right: 0; top: calc(100% + 0.3rem); min-width: 12rem; border: 1px solid var(--border); border-radius: 0.6rem; padding: 0.3rem; background: var(--surface); box-shadow: 0 0.6rem 1.4rem rgb(0 0 0 / 0.15); }
  .project-menu-options button { display: block; width: 100%; border: 0; border-radius: 0.35rem; padding: 0.6rem; background: transparent; color: var(--text); text-align: left; cursor: pointer; }
  .project-menu-options button:hover { background: var(--accent-soft); }
  .project-item:hover { border-color: #7faa8c; }
  .project span:nth-child(2) { flex: 1; min-width: 0; }
  .project strong, .project small { display: block; }
  .project small { margin-top: 0.3rem; color: #58665c; line-height: 1.4; }
  .project-color { width: 0.8rem; height: 0.8rem; border-radius: 50%; flex: none; }
  .project-overview { display: grid; flex: 0 1 19rem; grid-template-columns: 1fr auto; align-items: center; gap: 0.3rem 0.65rem; color: var(--subtle); font-size: 0.8rem; }
  .project-overview progress { grid-column: 1 / -1; width: 100%; height: 0.45rem; accent-color: var(--accent-text); }
  .project-progress-label { color: var(--accent-text); font-weight: 700; }
  .project-modal { width: min(34rem, calc(100% - 2rem)); max-height: calc(100dvh - 2rem); overflow-y: auto; border: 0; border-radius: 0.9rem; padding: 1.25rem; box-shadow: 0 1.5rem 4rem rgb(25 45 32 / 0.3); }
  .project-modal::backdrop { background: rgb(20 35 25 / 0.45); }
  .modal-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .modal-header h2 { margin: 0; font-size: 1.2rem; }
  .modal-close { border: 0; border-radius: 0.4rem; padding: 0.1rem 0.45rem; background: transparent; color: #58665c; font-size: 1.8rem; line-height: 1; }
  .modal-close:hover { background: #edf5ee; color: #27583b; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 0.65rem; }
  @media (max-width: 600px) {
    .project-item { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
    .project-menu { grid-column: 2; grid-row: 1; }
    .restore-project-form { grid-column: 1 / -1; }
    .restore-project-form .button { width: 100%; }
    .project { display: grid; grid-column: 1; grid-row: 1; grid-template-columns: 0.8rem minmax(0, 1fr) auto; align-items: start; gap: 0.65rem 0.75rem; }
    .project > span:nth-child(2) { grid-column: 2; grid-row: 1; min-width: 0; overflow-wrap: anywhere; }
    .project-color { grid-column: 1; grid-row: 1 / span 2; align-self: center; }
    .project-overview { grid-column: 2; grid-row: 2; width: 100%; min-width: 0; }
    .project-overview-label { overflow-wrap: anywhere; }
    .project > span:last-child { grid-column: 3; grid-row: 1 / span 2; align-self: center; }
  }
  @media (max-width: 360px) {
    .project-modal .modal-actions { flex-direction: column; }
    .project-modal .modal-actions .button { width: 100%; }
  }
</style>
