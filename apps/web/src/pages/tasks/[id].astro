---
import AppLayout from '../../layouts/AppLayout.astro';
import { createApiClient } from '../../lib/api';
import { formError } from '../../lib/form-error';
import { formValue } from '../../lib/form-value';
import { isSameOrigin } from '../../lib/security';
import { NexoApiNotFoundError } from '@nexo/api-client';
import { TaskStatusLabels, type Project, type Task, type TaskStatus } from '@nexo/contracts';

const id = Astro.params.id ?? '';
let task: Task | null = null;
let projects: Project[] = [];
let errorMessage: string | null = null;
let submittedForm: FormData | null = null;
let notFound = false;

if (Astro.request.method === 'POST') {
  if (!isSameOrigin(Astro.request, Astro.url)) {
    return new Response('Origen no permitido', { status: 403 });
  }
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  submittedForm = intent === 'save' ? form : null;
  try {
    const api = createApiClient();
    if (intent === 'complete') {
      await api.completeTask(id);
    } else if (intent === 'reopen') {
      await api.reopenTask(id);
    } else if (intent === 'move-to-inbox') {
      await api.moveTaskToInbox(id);
    } else if (intent === 'pin' || intent === 'unpin') {
      await api.updateTask(id, { pinned: intent === 'pin' });
    } else if (intent === 'save') {
      const current = await api.getTask(id);
      const status = String(form.get('status') ?? 'pending') as TaskStatus;
      const dueAt = String(form.get('dueAt') ?? '');
      const dueAtIso = String(form.get('dueAtIso') ?? '');
      const startedAt = String(form.get('startedAt') ?? '');
      const startedAtIso = String(form.get('startedAtIso') ?? '');
      const selectedProjectId = String(form.get('projectId') ?? '') || null;
      await api.updateTask(id, {
        title: String(form.get('title') ?? ''),
        notes: String(form.get('notes') ?? '') || null,
        ...(selectedProjectId === current.projectId ? {} : { projectId: selectedProjectId }),
        status,
        priority: String(form.get('priority') ?? 'medium') as Task['priority'],
        scheduledFor: String(form.get('scheduledFor') ?? '') || null,
        dueAt: dueAt ? dueAtIso || new Date(dueAt).toISOString() : null,
        startedAt: startedAt ? startedAtIso || new Date(startedAt).toISOString() : null,
        blockedReason: status === 'blocked' ? String(form.get('blockedReason') ?? '') : null,
        completedAt: status === 'done' ? current.completedAt ?? new Date().toISOString() : null,
      });
    } else {
      throw new Error('Acción desconocida');
    }
    return Astro.redirect(`/tasks/${id}`, 303);
  } catch (error) {
    console.error('No se pudo guardar la tarea:', error);
    const failure = formError(error, 'No se pudieron guardar los cambios. Revisa los campos e inténtalo de nuevo.');
    errorMessage = failure.message;
    Astro.response.status = failure.status;
  }
}

try {
  const api = createApiClient();
  task = await api.getTask(id);
} catch (error) {
  if (error instanceof NexoApiNotFoundError) {
    notFound = true;
    Astro.response.status = 404;
  } else {
    console.error('No se pudo cargar la tarea:', error);
    errorMessage ??= 'No se pudo cargar la tarea. Comprueba la conexión con la API.';
  }
}

if (task) {
  try {
    const api = createApiClient();
    const [active, archived] = await Promise.all([
      api.listProjects({ status: 'active' }),
      api.listProjects({ status: 'archived' }),
    ]);
    projects = [...active, ...archived];
  } catch (error) {
    console.error('No se pudieron cargar los proyectos para la tarea:', error);
    errorMessage ??= 'La tarea está disponible, pero no se pudo cargar la lista de proyectos.';
  }
}

const backHref = task?.projectId ? `/projects/${task.projectId}` : '/inbox';
---

<AppLayout title={task ? `${task.title} · Nexo` : 'Tarea · Nexo'} section={task?.projectId ? 'projects' : 'inbox'}>
  <main class="page">
    <a class="back-link" href={backHref}>← Volver</a>
    {notFound ? (
      <div class="notice"><h1>Tarea no encontrada</h1><p>Comprueba el enlace e inténtalo de nuevo.</p></div>
    ) : task ? (
      <>
        <header class="page-header"><div><p class="eyebrow">{TaskStatusLabels[task.status]}</p><h1>{task.title}</h1></div></header>
        {errorMessage && <div class="notice error" role="alert"><p>{errorMessage}</p></div>}
        <div class="task-layout">
          <section class="card">
            <h2>Detalles de la tarea</h2>
            <form method="post" class="form-grid" id="task-form">
              <input type="hidden" name="intent" value="save" />
              <label class="field">Título <input name="title" required maxlength="200" value={formValue(submittedForm, 'title', task.title)} /></label>
              <label class="field">Notas <textarea name="notes" maxlength="2000">{formValue(submittedForm, 'notes', task.notes ?? '')}</textarea></label>
              <label class="field">Proyecto
                <select name="projectId">
                  <option value="" selected={formValue(submittedForm, 'projectId', task.projectId ?? '') === ''}>Sin proyecto (inbox)</option>
                  {projects.map((project) => <option value={project.id} selected={formValue(submittedForm, 'projectId', task.projectId ?? '') === project.id} disabled={project.status === 'archived' && task.projectId !== project.id}>{project.name}{project.status === 'archived' ? ' (archivado)' : ''}</option>)}
                </select>
              </label>
              <div class="field-pair">
                <label class="field">Estado
                  <select name="status" id="task-status">
                    <option value="pending" selected={formValue(submittedForm, 'status', task.status) === 'pending'}>Pendiente</option>
                    <option value="in_progress" selected={formValue(submittedForm, 'status', task.status) === 'in_progress'}>En progreso</option>
                    <option value="in_review" selected={formValue(submittedForm, 'status', task.status) === 'in_review'}>En revisión</option>
                    <option value="done" selected={formValue(submittedForm, 'status', task.status) === 'done'}>Completada</option>
                    <option value="blocked" selected={formValue(submittedForm, 'status', task.status) === 'blocked'}>Bloqueada</option>
                  </select>
                </label>
                <label class="field">Prioridad
                  <select name="priority">
                    <option value="low" selected={formValue(submittedForm, 'priority', task.priority) === 'low'}>Baja</option>
                    <option value="medium" selected={formValue(submittedForm, 'priority', task.priority) === 'medium'}>Media</option>
                    <option value="high" selected={formValue(submittedForm, 'priority', task.priority) === 'high'}>Alta</option>
                  </select>
                </label>
              </div>
              <div class="field-pair">
                <label class="field">Programada para <input name="scheduledFor" type="date" value={formValue(submittedForm, 'scheduledFor', task.scheduledFor ?? '')} /></label>
                <label class="field">Fecha límite <input name="dueAt" id="task-due-at" type="datetime-local" value={formValue(submittedForm, 'dueAt', task.dueAt?.slice(0, 16) ?? '')} data-iso={submittedForm ? '' : task.dueAt ?? ''} /></label>
              </div>
              <input name="dueAtIso" id="task-due-at-iso" type="hidden" />
              <label class="field">Inicio <input name="startedAt" id="task-started-at" type="datetime-local" value={formValue(submittedForm, 'startedAt', task.startedAt?.slice(0, 16) ?? '')} data-iso={submittedForm ? '' : task.startedAt ?? ''} /></label>
              <input name="startedAtIso" id="task-started-at-iso" type="hidden" />
              <label class="field" id="blocked-reason-field">Motivo de bloqueo <input name="blockedReason" value={formValue(submittedForm, 'blockedReason', task.blockedReason ?? '')} placeholder="¿Qué estás esperando?" /></label>
              <button class="button" type="submit">Guardar cambios</button>
            </form>
          </section>
          <aside class="card actions">
            <h2>Acciones rápidas</h2>
            <form method="post"><button class="button secondary" type="submit" name="intent" value={task.pinned ? 'unpin' : 'pin'}>{task.pinned ? 'Desanclar de inicio' : 'Anclar en inicio'}</button></form>
            {task.status === 'done' ? (
              <form method="post"><button class="button secondary" type="submit" name="intent" value="reopen">Reabrir tarea</button></form>
            ) : (
              <form method="post"><button class="button" type="submit" name="intent" value="complete">Completar tarea</button></form>
            )}
            {task.projectId && <form method="post"><button class="button secondary" type="submit" name="intent" value="move-to-inbox">Mover al inbox</button></form>}
          </aside>
        </div>
      </>
    ) : (
      <div class="notice error" role="alert"><h1>Tarea no disponible</h1><p>{errorMessage}</p></div>
    )}
  </main>
</AppLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#task-form');
  const status = document.querySelector<HTMLSelectElement>('#task-status');
  const blockedField = document.querySelector<HTMLElement>('#blocked-reason-field');
  const blockedInput = blockedField?.querySelector<HTMLInputElement>('input');
  const dueAt = document.querySelector<HTMLInputElement>('#task-due-at');
  const dueAtIso = document.querySelector<HTMLInputElement>('#task-due-at-iso');
  const startedAt = document.querySelector<HTMLInputElement>('#task-started-at');
  const startedAtIso = document.querySelector<HTMLInputElement>('#task-started-at-iso');

  function displayLocalTime(input: HTMLInputElement | null) {
    if (!input?.dataset.iso) return;
    const date = new Date(input.dataset.iso);
    input.value = new Date(date.getTime() - date.getTimezoneOffset() * 60_000)
      .toISOString()
      .slice(0, 16);
  }

  displayLocalTime(dueAt);
  displayLocalTime(startedAt);

  function syncBlockedReason() {
    const isBlocked = status?.value === 'blocked';
    if (blockedField) blockedField.hidden = !isBlocked;
    if (blockedInput) blockedInput.required = isBlocked;
  }

  status?.addEventListener('change', syncBlockedReason);
  syncBlockedReason();
  form?.addEventListener('submit', () => {
    if (dueAtIso && dueAt) dueAtIso.value = dueAt.value ? new Date(dueAt.value).toISOString() : '';
    if (startedAtIso && startedAt) startedAtIso.value = startedAt.value ? new Date(startedAt.value).toISOString() : '';
  });
</script>

<style>
  .back-link { display: inline-block; margin-bottom: 1.5rem; color: #316d4b; font-weight: 650; text-decoration: none; }
  .task-layout { display: grid; grid-template-columns: minmax(0, 1fr) 14rem; gap: 1.3rem; align-items: start; }
  .field-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .field[hidden] { display: none; }
  .actions { display: grid; gap: 0.8rem; }
  .actions form, .actions button { width: 100%; }
  @media (max-width: 900px) { .task-layout { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .field-pair { grid-template-columns: 1fr; } }
</style>
