---
import AppLayout from '../layouts/AppLayout.astro';
import { createApiClient } from '../lib/api';
import type { Project, Task } from '@nexo/contracts';

let tasks: Task[] = [];
let projects: Project[] = [];
let errorMessage: string | null = null;
const showDone = Astro.url.searchParams.get('status') === 'done';
const priorityParam = Astro.url.searchParams.get('priority');
const priorityFilter = ['low', 'medium', 'high'].includes(priorityParam ?? '')
  ? priorityParam as Task['priority']
  : undefined;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  try {
    const projectId = String(form.get('projectId') ?? '') || null;
    await createApiClient().createTask({
      title: String(form.get('title') ?? ''),
      notes: String(form.get('notes') ?? '') || null,
      priority: String(form.get('priority') ?? 'medium') as Task['priority'],
      scheduledFor: String(form.get('scheduledFor') ?? '') || null,
      projectId,
    });
    return Astro.redirect(projectId ? `/projects/${projectId}` : '/inbox', 303);
  } catch (error) {
    console.error('No se pudo crear la tarea:', error);
    errorMessage = 'No se pudo crear la tarea. Comprueba el título y vuelve a intentarlo.';
    Astro.response.status = 400;
  }
}

try {
  const api = createApiClient();
  [tasks, projects] = await Promise.all([
    api.listTasks({ priority: priorityFilter }),
    api.listProjects({ status: 'active' }),
  ]);
  tasks = tasks.filter((task) =>
    task.projectId === null && (showDone ? task.status === 'done' : task.status !== 'done'),
  );
} catch (error) {
  console.error('No se pudo cargar el inbox:', error);
  errorMessage ??= 'No se pudo conectar con la API. Vuelve a intentarlo.';
}
---

<AppLayout title="Inbox · Nexo" section="inbox">
  <main class="page">
    <header class="page-header"><div><p class="eyebrow">Captura rápida</p><h1>Inbox</h1><p class="page-intro">Anota lo que tienes en mente. Organízalo después.</p></div></header>
    {errorMessage && <div class="notice error" role="alert"><p>{errorMessage}</p><a href="/inbox">Volver a intentar</a></div>}

    <form class="capture card" method="post">
      <label class="field">Nueva tarea <input name="title" maxlength="200" required placeholder="¿Qué tienes pendiente?" autocomplete="off" /></label>
      <div class="capture-details">
        <label class="field">Notas <textarea name="notes" maxlength="2000" placeholder="Detalles opcionales"></textarea></label>
        <label class="field">Proyecto
          <select name="projectId"><option value="">Sin proyecto</option>{projects.map((project) => <option value={project.id}>{project.name}</option>)}</select>
        </label>
        <label class="field">Prioridad
          <select name="priority"><option value="medium">Media</option><option value="low">Baja</option><option value="high">Alta</option></select>
        </label>
        <label class="field">Programada para <input name="scheduledFor" type="date" /></label>
      </div>
      <button class="button" type="submit">Crear tarea</button>
    </form>

    <div class="tabs">
      <a href={`/inbox${priorityFilter ? `?priority=${priorityFilter}` : ''}`} aria-current={!showDone ? 'page' : undefined}>Pendientes</a>
      <a href={`/inbox?status=done${priorityFilter ? `&priority=${priorityFilter}` : ''}`} aria-current={showDone ? 'page' : undefined}>Completadas</a>
    </div>
    <form method="get" class="filters">
      {showDone && <input type="hidden" name="status" value="done" />}
      <label class="field">Prioridad
        <select name="priority">
          <option value="">Todas</option>
          <option value="low" selected={priorityFilter === 'low'}>Baja</option>
          <option value="medium" selected={priorityFilter === 'medium'}>Media</option>
          <option value="high" selected={priorityFilter === 'high'}>Alta</option>
        </select>
      </label>
      <button class="button secondary" type="submit">Filtrar</button>
    </form>
    {!errorMessage && tasks.length === 0 && <div class="notice"><h2>{priorityFilter ? 'No hay tareas con esta prioridad' : showDone ? 'Nada completado todavía' : 'Inbox vacío'}</h2><p>{priorityFilter ? 'Prueba con otra prioridad o muestra todas.' : showDone ? 'Las tareas que completes aparecerán aquí.' : 'Cuando captures una tarea, aparecerá aquí.'}</p></div>}
    <ul class="tasks">
      {tasks.map((task) => (
        <li><a class="task card" href={`/tasks/${task.id}`}><span><strong>{task.title}</strong>{task.notes && <small>{task.notes}</small>}</span><small>{task.status.replace('_', ' ')} · {task.priority}</small></a></li>
      ))}
    </ul>
  </main>
</AppLayout>

<style>
  .capture { display: grid; gap: 0.9rem; margin-bottom: 2rem; }
  .capture-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
  .capture-details .field:first-child { grid-row: span 2; }
  .capture button { justify-self: start; }
  .tabs { display: flex; gap: 1rem; margin-bottom: 1rem; border-bottom: 1px solid #dce2da; }
  .tabs a { padding: 0.6rem 0.2rem; text-decoration: none; color: #58665c; }
  .tabs a[aria-current="page"] { border-bottom: 2px solid #316d4b; color: #173a27; font-weight: 700; }
  .filters { display: flex; align-items: end; gap: 0.6rem; max-width: 22rem; margin-bottom: 1rem; }
  .filters .field { flex: 1; }
  .tasks { display: grid; gap: 0.7rem; padding: 0; margin: 0; list-style: none; }
  .task { display: flex; justify-content: space-between; gap: 1rem; text-decoration: none; }
  .task:hover { border-color: #7faa8c; }
  .task small { color: #58665c; }
  .task span small { display: block; margin-top: 0.3rem; }
  @media (max-width: 600px) { .capture-details { grid-template-columns: 1fr; } .task { flex-direction: column; align-items: stretch; } }
</style>
