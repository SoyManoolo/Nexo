---
import AppLayout from '../layouts/AppLayout.astro';
import { createApiClient } from '../lib/api';
import { TaskStatusLabels, type Project, type Task } from '@nexo/contracts';

const timeZone = process.env.NEXO_TIME_ZONE ?? 'Europe/Madrid';
const localDay = new Intl.DateTimeFormat('sv-SE', { timeZone });
const today = localDay.format(new Date());
const dateParam = Astro.url.searchParams.get('date');
const selectedDay = dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam) &&
  !Number.isNaN(Date.parse(`${dateParam}T12:00:00Z`)) &&
  new Date(`${dateParam}T12:00:00Z`).toISOString().slice(0, 10) === dateParam
  ? dateParam : today;
const view = Astro.url.searchParams.get('view') === 'week' ? 'week' : 'month';
const anchor = new Date(`${selectedDay}T12:00:00Z`);
const dateKey = (date: Date) => date.toISOString().slice(0, 10);
const addDays = (date: Date, amount: number) => {
  const next = new Date(date);
  next.setUTCDate(next.getUTCDate() + amount);
  return next;
};
const mondayOffset = (date: Date) => (date.getUTCDay() + 6) % 7;
const firstOfMonth = new Date(Date.UTC(anchor.getUTCFullYear(), anchor.getUTCMonth(), 1, 12));
const periodStart = view === 'week'
  ? addDays(anchor, -mondayOffset(anchor))
  : addDays(firstOfMonth, -mondayOffset(firstOfMonth));
const daysInMonth = new Date(Date.UTC(anchor.getUTCFullYear(), anchor.getUTCMonth() + 1, 0)).getUTCDate();
const monthCells = Math.ceil((mondayOffset(firstOfMonth) + daysInMonth) / 7) * 7;
const days = Array.from({ length: view === 'week' ? 7 : monthCells }, (_, index) => dateKey(addDays(periodStart, index)));
const previous = view === 'week'
  ? dateKey(addDays(anchor, -7))
  : dateKey(new Date(Date.UTC(anchor.getUTCFullYear(), anchor.getUTCMonth() - 1, 1, 12)));
const next = view === 'week'
  ? dateKey(addDays(anchor, 7))
  : dateKey(new Date(Date.UTC(anchor.getUTCFullYear(), anchor.getUTCMonth() + 1, 1, 12)));
const link = (mode: 'week' | 'month', date: string) => `/?view=${mode}&date=${date}`;
const monthLabel = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(anchor);
const shortDate = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const periodLabel = view === 'month' ? monthLabel : `${shortDate.format(periodStart)} – ${shortDate.format(addDays(periodStart, 6))}`;
const dayLabel = new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });

const searchQuery = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 120);
const searchStatus = Astro.url.searchParams.get('status') ?? '';
const searchPriority = Astro.url.searchParams.get('priority') ?? '';
const searchProject = Astro.url.searchParams.get('project') ?? '';
const searchTag = (Astro.url.searchParams.get('tag') ?? '').trim().slice(0, 40);
const validStatuses = ['pending', 'in_progress', 'in_review', 'done', 'blocked'];
const validPriorities = ['low', 'medium', 'high'];
const hasSearch = Boolean(searchQuery || searchStatus || searchPriority || searchProject || searchTag);

let tasks: Task[] = [];
let projects: Project[] = [];
let errorMessage: string | null = null;
try {
  const api = createApiClient();
  [tasks, projects] = await Promise.all([api.listTasks(), api.listProjects()]);
} catch (error) {
  console.error('No se pudieron cargar las tareas del inicio:', error);
  errorMessage = 'No se pudieron cargar las tareas. Comprueba la conexión con la API.';
}

const projectNames = new Map(projects.map((project) => [project.id, project.name]));
const normalizedSearch = searchQuery.toLocaleLowerCase('es');
const searchedTasks = tasks.filter((task) => {
  if (validStatuses.includes(searchStatus) && task.status !== searchStatus) return false;
  if (validPriorities.includes(searchPriority) && task.priority !== searchPriority) return false;
  if (searchProject && task.projectId !== searchProject) return false;
  if (searchTag && !task.tags.some((tag) => tag.toLocaleLowerCase('es') === searchTag.toLocaleLowerCase('es'))) return false;
  if (!normalizedSearch) return true;
  const searchable = [task.title, task.notes ?? '', task.blockedReason ?? '', ...task.tags, projectNames.get(task.projectId ?? '') ?? ''].join(' ').toLocaleLowerCase('es');
  return searchable.includes(normalizedSearch);
});
const searchedProjects = projects.filter((project) => !normalizedSearch || `${project.name} ${project.description ?? ''} ${project.notes ?? ''}`.toLocaleLowerCase('es').includes(normalizedSearch));

const pinned = tasks.filter((task) => task.pinned);
const newest = [...tasks].sort((a, b) => b.createdAt.localeCompare(a.createdAt) || b.id.localeCompare(a.id)).slice(0, 3);
const eventsFor = (day: string) => tasks.flatMap((task) => {
  const planned = task.scheduledFor === day;
  const deadline = task.dueAt !== null && localDay.format(new Date(task.dueAt)) === day;
  return planned || deadline ? [{ task, kind: planned && deadline ? 'both' : planned ? 'planned' : 'deadline' }] : [];
});
---

<AppLayout title="Inicio · Nexo" section="home">
  <main class="page home-page">
    <header class="page-header"><div><p class="eyebrow">Tu espacio</p><h1>Inicio</h1><p class="page-intro">Tus planes y fechas importantes, de un vistazo.</p></div></header>
    {errorMessage && <div class="notice error" role="alert"><p>{errorMessage}</p><a href="/">Volver a intentar</a></div>}

    <section class:list={['home-search card', { 'has-results': hasSearch }]} aria-label="Búsqueda global">
      <form method="get" class="home-search-form">
        <label class="field search-query">Buscar tareas o proyectos <input name="q" type="search" value={searchQuery} placeholder="Nombre, nota o etiqueta" /></label>
        <label class="field">Estado <select name="status"><option value="">Todos</option>{validStatuses.map((value) => <option value={value} selected={searchStatus === value}>{TaskStatusLabels[value as Task['status']]}</option>)}</select></label>
        <label class="field">Prioridad <select name="priority"><option value="">Todas</option>{validPriorities.map((value) => <option value={value} selected={searchPriority === value}>{value === 'high' ? 'Alta' : value === 'medium' ? 'Media' : 'Baja'}</option>)}</select></label>
        <label class="field">Proyecto <select name="project"><option value="">Todos</option>{projects.map((project) => <option value={project.id} selected={searchProject === project.id}>{project.name}</option>)}</select></label>
        <label class="field">Etiqueta <input name="tag" value={searchTag} maxlength="40" placeholder="Exacta" /></label>
        <button class="button" type="submit">Buscar</button>
      </form>
      {hasSearch && <div class="home-search-results">
        <h2>Resultados</h2>
        <div class="search-result-groups">
          <section><h3>Proyectos ({searchedProjects.length})</h3>{searchedProjects.length ? <ul>{searchedProjects.slice(0, 5).map((project) => <li><a href={`/projects/${project.id}`}>{project.name}</a></li>)}</ul> : <p class="empty">No hay proyectos coincidentes.</p>}</section>
          <section><h3>Tareas ({searchedTasks.length})</h3>{searchedTasks.length ? <ul>{searchedTasks.slice(0, 8).map((task) => <li><a href={`/tasks/${task.id}`}><strong>{task.title}</strong><small>{projectNames.get(task.projectId ?? '') ?? 'Inbox'} · {TaskStatusLabels[task.status]}{task.tags.length ? ` · ${task.tags.join(', ')}` : ''}</small></a></li>)}</ul> : <p class="empty">No hay tareas coincidentes.</p>}</section>
        </div>
      </div>}
    </section>

    <div class="dashboard-grid">
    <section class="calendar card" aria-label="Calendario de tareas">
      <div class="calendar-toolbar">
        <div><h2>Calendario</h2><p class="period">{periodLabel}</p></div>
        <div class="calendar-controls">
          <div class="view-switch" aria-label="Vista del calendario">
            <a href={link('month', selectedDay)} aria-current={view === 'month' ? 'page' : undefined}>Mes</a>
            <a href={link('week', selectedDay)} aria-current={view === 'week' ? 'page' : undefined}>Semana</a>
          </div>
          <a class="period-nav" href={link(view, previous)} aria-label={view === 'month' ? 'Mes anterior' : 'Semana anterior'}>←</a>
          <a class="period-nav" href={link(view, today)}>Hoy</a>
          <a class="period-nav" href={link(view, next)} aria-label={view === 'month' ? 'Mes siguiente' : 'Semana siguiente'}>→</a>
        </div>
      </div>
      <div class="calendar-scroll">
        <div class="calendar-grid" data-view={view}>
          {['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'].map((name) => <div class="weekday">{name}</div>)}
          {days.map((day) => (
            <div class:list={['calendar-day', { 'outside-month': view === 'month' && day.slice(0, 7) !== selectedDay.slice(0, 7), today: day === today }]}>
              <time datetime={day} aria-label={dayLabel.format(new Date(`${day}T12:00:00Z`))}>{Number(day.slice(8))}</time>
              <div class="day-events">
                {eventsFor(day).map(({ task, kind }) => (
                  <a class:list={['calendar-event', kind, { done: task.status === 'done' }]} href={`/tasks/${task.id}`} aria-label={`${task.title}, ${kind === 'both' ? 'programada y fecha límite' : kind === 'planned' ? 'programada' : 'fecha límite'}`} title={kind === 'both' ? 'Programada y fecha límite' : kind === 'planned' ? 'Programada' : 'Fecha límite'}>{task.title}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="legend"><span><i class="planned-dot"></i> Programada</span><span><i class="deadline-dot"></i> Fecha límite</span></div>
    </section>

    <aside class="home-lists">
      <section class="card" aria-labelledby="pinned-heading">
        <h2 id="pinned-heading">Tareas ancladas</h2>
        {pinned.length ? <ul>{pinned.map((task) => <li><a href={`/tasks/${task.id}`}>{task.title}</a></li>)}</ul> : <p class="empty">Aún no hay tareas ancladas. Abre una tarea y elige «Anclar en inicio».</p>}
      </section>
      <section class="card" aria-labelledby="newest-heading">
        <h2 id="newest-heading">Las 3 tareas más nuevas</h2>
        {newest.length ? <ul>{newest.map((task) => <li><a href={`/tasks/${task.id}`}>{task.title}</a></li>)}</ul> : <p class="empty">Las tareas que crees aparecerán aquí.</p>}
      </section>
    </aside>
    </div>
  </main>
</AppLayout>

<style>
  .home-search { margin-bottom: 1rem; }
  .home-search.has-results { position: relative; z-index: 3; }
  .home-search-form { display: grid; grid-template-columns: minmax(13rem, 2fr) repeat(4, minmax(7rem, 1fr)) auto; align-items: end; gap: 0.7rem; }
  .home-search-form .field { min-width: 0; }
  .home-search-form .button { min-height: 2.65rem; white-space: nowrap; }
  .home-search-results { position: absolute; z-index: 4; top: calc(100% + 0.5rem); inset-inline: 0; box-sizing: border-box; max-height: min(65vh, 42rem); overflow-y: auto; border: 1px solid var(--border); border-radius: 1rem; padding: 1rem; background: var(--surface); box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.28); }
  .home-search-results h2 { margin: 0 0 0.8rem; font-size: 1.1rem; }
  .search-result-groups { display: grid; grid-template-columns: 1fr 2fr; gap: 1rem; }
  .search-result-groups h3 { margin: 0 0 0.4rem; font-size: 0.9rem; }
  .search-result-groups ul { list-style: none; margin: 0; padding: 0; }
  .search-result-groups li + li { border-top: 1px solid var(--border); }
  .search-result-groups li a { display: grid; gap: 0.2rem; padding: 0.55rem 0; text-decoration: none; }
  .search-result-groups li a:hover { color: var(--accent-text); }
  .search-result-groups small { color: var(--subtle); }
  .dashboard-grid { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; align-items: start; gap: 1.25rem; }
  .calendar { padding: 1rem; min-width: 0; }
  .calendar-toolbar, .calendar-controls, .view-switch, .legend { display: flex; align-items: center; gap: 0.5rem; }
  .calendar-toolbar { justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.8rem; }
  .calendar-toolbar h2 { margin: 0 0 0.2rem; }
  .period { margin: 0; color: #58665c; text-transform: capitalize; }
  .calendar-controls { flex-wrap: wrap; }
  .view-switch { padding: 0.2rem; background: #edf3ec; border-radius: 0.6rem; }
  .view-switch a, .period-nav { padding: 0.45rem 0.7rem; border-radius: 0.45rem; text-decoration: none; font-weight: 650; }
  .view-switch a[aria-current="page"] { background: #fff; box-shadow: 0 1px 4px #17211c20; }
  .period-nav { border: 1px solid #dce2da; }
  .period-nav:hover, .view-switch a:hover { background: #e0ede0; }
  .calendar-scroll { overflow-x: auto; }
  .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(5.5rem, 1fr)); min-width: 38.5rem; border-top: 1px solid #dce2da; border-left: 1px solid #dce2da; }
  .weekday { padding: 0.4rem; text-align: center; color: #58665c; font-size: 0.78rem; font-weight: 750; background: #f4f7f2; border-right: 1px solid #dce2da; border-bottom: 1px solid #dce2da; }
  .calendar-day { min-height: 4.4rem; padding: 0.35rem; border-right: 1px solid #dce2da; border-bottom: 1px solid #dce2da; }
  .calendar-grid[data-view="week"] .calendar-day { min-height: 9rem; }
  .calendar-day.outside-month { background: #f8f9f6; }
  .calendar-day time { display: inline-flex; align-items: center; justify-content: center; width: 1.7rem; height: 1.7rem; color: #4d5d52; font-size: 0.8rem; }
  .calendar-day.today time { background: #316d4b; color: #fff; border-radius: 50%; }
  .day-events { display: grid; gap: 0.15rem; margin-top: 0.15rem; }
  .calendar-event { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-radius: 0.25rem; padding: 0.25rem 0.3rem 0.25rem 0.45rem; font-size: 0.75rem; text-decoration: none; background: #e7f2e8; border-left: 3px solid #397d53; }
  .calendar-event.deadline { background: #fff1e7; border-left-color: #bd673d; }
  .calendar-event.both { background: #f2eafa; border-left-color: #794da4; }
  .calendar-event.done { opacity: 0.6; text-decoration: line-through; }
  .calendar-event:hover { filter: brightness(0.94); }
  .legend { gap: 1rem; margin-top: 0.8rem; color: #58665c; font-size: 0.8rem; }
  .legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .legend i { width: 0.65rem; height: 0.65rem; border-radius: 50%; background: #397d53; }
  .legend .deadline-dot { background: #bd673d; }
  .home-lists { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .home-lists ul { list-style: none; margin: 0; padding: 0; }
  .home-lists li + li { border-top: 1px solid #e6ebe5; }
  .home-lists li a { display: block; padding: 0.7rem 0; text-decoration: none; }
  .home-lists li a:hover { color: #316d4b; }
  .empty { margin: 0; color: #58665c; line-height: 1.5; }
  @media (max-width: 1050px) { .dashboard-grid { grid-template-columns: 1fr; } .home-lists { grid-template-columns: repeat(2, minmax(0, 1fr)); } .home-search-form { grid-template-columns: repeat(3, minmax(0, 1fr)); } .search-query { grid-column: span 2; } }
  @media (max-width: 720px) { .home-lists { grid-template-columns: 1fr; } .calendar { padding: 0.8rem; } .home-search-form { grid-template-columns: 1fr 1fr; } .search-query { grid-column: span 2; } .home-search-form .button { grid-column: 1 / -1; } .search-result-groups { grid-template-columns: 1fr; } }
</style>
