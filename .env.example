POSTGRES_DB=nexo
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# URL para los servicios que se conecten a PostgreSQL desde el host.
DATABASE_URL=postgresql://nexo:nexo@127.0.0.1:5432/nexo
DATABASE_POOL_MAX=10

# Secreto usado por la API para cifrar el token de GitHub guardado en Ajustes.
# Genera un valor propio largo y privado antes de conectar GitHub.
GITHUB_TOKEN_ENCRYPTION_KEY=

# Servidor MCP Streamable HTTP (apps/mcp)
MCP_HOST=127.0.0.1
MCP_PORT=3100
NEXO_API_BASE_URL=http://127.0.0.1:3000
# Define un token largo antes de exponer el MCP en la tailnet.
# MCP_AUTH_TOKEN=
